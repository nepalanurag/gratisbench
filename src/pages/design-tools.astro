---
import BaseLayout from '../layouts/BaseLayout.astro';
import { basePath, siteUrl } from '../lib/site';
import { ALL_TOOLS } from '../lib/tools';

const title = 'Design Tools - Free Logo Maker, OG Images & Mockups | FreeKit';
const description =
  'Free design tools that run in your browser: a wordmark logo maker with PNG and SVG download, a social card generator, and a device mockup generator. No signup, no download fees.';

const toolsRaw = [
  { href: '/logo-maker', name: 'Logo maker', desc: 'Simple wordmark-style logos: pick an icon, shape, font, and colors, then download PNG and SVG. No $20 download fee.' },
  { href: '/og-image-generator', name: 'OG image generator', desc: 'Social cards in four sizes (1200x630, square, wide, X card) with themes and patterns. Full-resolution PNG download.' },
  { href: '/device-mockup-generator', name: 'Device mockup generator', desc: 'Frame a screenshot in a browser window, phone, or laptop with backgrounds, padding, and shadow. PNG export.' },
] as const;

const tagByHref = new Map(ALL_TOOLS.map((t) => [t.href, t.tag]));
const tools = toolsRaw.map((t, i) => ({ ...t, num: String(i + 1).padStart(2, '0'), tag: tagByHref.get(t.href) ?? '' }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'FreeKit design tools',
  url: siteUrl(Astro.site) + basePath('/design-tools'),
  description,
};
---
<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="wrap">
    <div class="page-head">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={basePath("/")}>FreeKit</a><span><span class="sep">/</span><a href={basePath("/design-tools")}>Design tools</a></span>
      </nav>
      <h1>Design tools</h1>
      <p class="lede">
        The design work a small project actually needs: a logo, a social card, a mockup.
        Free, private, and in your browser.
      </p>
      <p class="privacy-line">Your data never leaves your device.</p>
    </div>

    <!-- Ad slot: hub top (AdSense display unit goes here) -->
    <div class="ad-slot" data-ad-slot="hub-top" aria-hidden="true"><span>Advertisement</span></div>

    <div class="tool-index">
      {tools.map((t) => (
        <a class="tool-row" href={basePath(t.href)}>
          <span class="tool-row-num">{t.num}</span>
          <span>
            <span class="tool-row-name">{t.name}</span>
            <p class="tool-row-desc">{t.desc}</p>
          </span>
          <span class="tool-row-tag">{t.tag}</span>
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </div>

    <div class="content">
      <h2>What these tools do</h2>
      <p>
        The three design jobs a side project hits first: a logo that looks intentional,
        a social card for the link, and a mockup that shows the product in a device.
        Looka charges $20 or more just to download the logo you designed, Bannerbear
        charges $49 a month to generate cards through an API, and Placeit charges
        $14.95 a month for device mockups. Each of those prices makes sense at scale;
        none of them makes sense for one project.
      </p>
      <p>
        The logo maker stays tightly scoped to simple wordmark-style logos, 18 stroke
        icons, four background shapes, four fonts, eight color presets, with PNG and
        SVG download. The OG image generator makes social cards in four exact sizes
        with text that wraps and shrinks to fit. The mockup generator frames your
        screenshot in a browser window, phone, or laptop, with a genuinely transparent
        background option. All three run entirely in your browser, and all three are
        free with no watermark and no account.
      </p>

      <h2>Common questions</h2>
      <dl>
        <div class="faq">
          <dt>Are these design tools free?</dt>
          <dd>Yes. All three are free with no limits, no watermarks, and no account. There is no download fee, no premium tier, and no branding badge to remove. The drawing happens on your device, so there is no per-file server cost to recover.</dd>
        </div>
        <div class="faq">
          <dt>Can I use the logo for my business?</dt>
          <dd>Yes, the logo you make is yours. But keep the scope in mind: these are simple wordmark-style logos from templates, not distinctive marks. They are right for side projects, newsletters, and prototypes. If the logo will carry a real brand, hire a designer before you trademark anything.</dd>
        </div>
        <div class="faq">
          <dt>Is my work private?</dt>
          <dd>Yes. Everything is generated in your browser and nothing is uploaded. For unreleased products and client work, that matters: your screenshots and drafts never sit on someone else&rsquo;s server.</dd>
        </div>
        <div class="faq">
          <dt>Can I save my logo to my business profile?</dt>
          <dd>Yes. The logo maker has a &ldquo;Save logo to business profile&rdquo; button that stores the finished logo in the shared business profile in this browser, so tools like the invoice generator pick it up automatically.</dd>
        </div>
      </dl>
    </div>

    <!-- Ad slot: hub bottom (AdSense display unit goes here) -->
    <div class="ad-slot" data-ad-slot="hub-bottom" aria-hidden="true"><span>Advertisement</span></div>
  </div>
</BaseLayout>
