---
import ToolPage from '../layouts/ToolPage.astro';

const title = 'Split PDF Free — Extract Pages, No Signup, No Watermark';
const description =
  'Extract pages from a PDF into new documents for free. Split by page ranges like 1-3, 5. No signup, no watermark. Your files never leave your browser.';
const h1 = 'Split PDF';
const lede = 'This tool is now part of the PDF Editor, which splits PDFs and handles every other PDF job in one workspace.';
---
<ToolPage
  title={title}
  description={description}
  h1={h1}
  lede={lede}
  crumbs={[{ label: 'PDF tools', href: '/pdf-tools' }, { label: 'Split PDF', href: '/split-pdf' }]}
  toolName="TruePDF Split PDF"
  intro={[
    'Splitting PDFs now happens inside the PDF Editor. Drop your file there, select the pages you want, and save them as a new PDF. The same workspace also lets you reorder, rotate, delete, edit text, add watermarks and page numbers, or protect the file with a password.',
  ]}
  steps={[]}
  specs={[]}
  faqs={[]}
>
  <div style="text-align: center; padding: 40px 20px;">
    <p style="font-size: 18px; margin-bottom: 20px;">This tool has moved into the PDF Editor.</p>
    <a href="/pdf-editor" style="display: inline-block; padding: 12px 24px; background: var(--accent); color: white; text-decoration: none; border-radius: 6px; font-weight: 600;">Open the PDF Editor</a>
  </div>
  <script>
    setTimeout(() => { window.location.replace('/pdf-editor'); }, 2500);
  </script>
</ToolPage>
