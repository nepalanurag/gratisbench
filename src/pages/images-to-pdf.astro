---
import ToolPage from '../layouts/ToolPage.astro';
import Icon from '../components/Icon.astro';

const title = 'Images to PDF Free — Convert Images to PDF, No Signup, No Watermark';
const description =
  'Turn JPG, PNG, and WebP images into a PDF for free. Choose page size, reorder pages, no signup, no watermark. Your files never leave your browser.';
const h1 = 'Images to PDF';
const lede = 'Turn a set of images into one PDF. Pick the page size, arrange the order, download. Free, no account, no watermark.';
---
<ToolPage
  title={title}
  description={description}
  h1={h1}
  lede={lede}
  crumbs={[{ label: 'PDF tools', href: '/pdf-tools' }, { label: 'Images to PDF', href: '/images-to-pdf' }]}
  toolName="TruePDF Images to PDF"
  intro={[
    'Photos of documents, scanned pages from a phone camera, screenshots, receipts: sooner or later a pile of images needs to become one PDF. Maybe a form asks for a single file, or you want to archive a set of scans properly. The usual converters handle it, but they cap how many images you can convert, shrink your files, or make you create an account before you can download.',
    'This converter takes your images and lays each one onto its own PDF page, in the order you arrange. You choose the page size: match each page to its image exactly, or fit every image onto standard A4 or US Letter pages with clean margins. PNG and JPEG files go in untouched; WebP, GIF and BMP are converted losslessly in your browser first, so almost any image works.',
    'As with every TruePDF tool, the conversion runs entirely on your device. That matters more than usual here, because the images people convert are often personal: IDs, receipts, handwritten notes. They are never uploaded, never stored, and never seen by anyone but you.',
  ]}
  steps={[
    'Drop your images onto the box above, click it to browse, or paste screenshots straight from your clipboard (Ctrl+V). They appear as thumbnails in order.',
    'Drag the rows into page order — the first image becomes page one. On touch screens, use the up and down arrows.',
    'Choose a page size: fit each page to its image, or use A4 or US Letter with your choice of orientation and margins.',
    'Click "Create PDF" and download the result.',
  ]}
  specs={[
    ['Cost', 'Free, no limits'],
    ['Signup', 'None. No account, no email.'],
    ['Watermark', 'None'],
    ['Where files are processed', 'In your browser, on your device'],
    ['Input formats', 'PNG, JPEG, WebP, GIF, BMP — or paste screenshots from your clipboard'],
    ['Page sizes', 'Fit to image, A4, US Letter — with portrait/landscape orientation and slim, wide, or no margins'],
    ['Reordering', 'Drag rows, or use the up/down arrows'],
    ['Image limit', 'None enforced. Very large sets are limited only by your device\u2019s memory.'],
    ['Quality', 'PNG and JPEG are embedded as-is; other formats are converted losslessly to PNG first'],
    ['Works offline', 'Yes, once the page has loaded'],
  ]}
  faqs={[
    {
      q: 'Is converting images to PDF really free?',
      a: 'Yes. No limits on the number of images, no watermarks, no account. The conversion is a local operation, so there is no per-file cost to pass on to you.',
    },
    {
      q: 'Are my images uploaded anywhere?',
      a: 'No. Everything happens in your browser on your own device. This is deliberate: people convert IDs, receipts, and personal photos, and none of that should travel to a server.',
    },
    {
      q: 'What is the difference between the page sizes?',
      a: '"Fit to image" makes each PDF page exactly the size of its image, with no scaling and no margins, which is best for photos and scans you want at full size. A4 and US Letter scale each image to fit a standard page, which is best for documents you plan to print. On those page sizes you can also pick the orientation (match each image, portrait, or landscape) and how much margin surrounds the image (none, slim, or wide).',
    },
    {
      q: 'Will my images lose quality?',
      a: 'PNG and JPEG files are kept exactly as they are, with no quality loss. WebP, GIF, and BMP are converted to PNG, which keeps full quality. Nothing is shrunk unless you choose A4 or Letter and the image is larger than the page.',
    },
    {
      q: 'How many images can I convert at once?',
      a: 'There is no built-in cap. The practical limit is your device\u2019s memory: a few dozen phone photos convert in seconds, while hundreds of huge images may take longer. If the browser struggles, convert in smaller batches and merge the PDFs afterwards.',
    },
    {
      q: 'Can I convert HEIC photos from my iPhone?',
      a: 'Not directly yet. iPhone photos in HEIC format need to be converted to JPEG or PNG first (your phone can do this when sharing or exporting). Standard JPEG and PNG exports work fine here.',
    },
    {
      q: 'Can I paste screenshots directly instead of saving files?',
      a: 'Yes. Copy a screenshot to your clipboard (Print Screen on Windows, Cmd+Shift+Ctrl+4 on Mac) and press Ctrl+V (or Cmd+V) on this page. The image is added to your list immediately, which makes this the fastest way to turn a few screenshots into a PDF.',
    },
    {
      q: 'The order of my pages is wrong. Can I fix it?',
      a: 'Yes. Drag any thumbnail row up or down to rearrange the images before converting — the list order is the page order in the final PDF. On touch screens, use the up and down arrows on each row instead.',
    },
    {
      q: 'Can I convert PNG screenshots and WebP images too?',
      a: 'Yes. PNG is embedded untouched, and WebP, GIF, and BMP are converted losslessly in your browser first. If your files are all JPG photos, the dedicated JPG to PDF page presets the picker for JPEG.',
    },
  ]}
  usecases={[
    {
      h: 'Phone scans to a proper PDF',
      p: 'Photos of documents, receipts, and whiteboards become a tidy multi-page PDF. Use A4 or US Letter when the result will be printed or filed.',
    },
    {
      h: 'Mixed image collections',
      p: 'JPG photos, PNG screenshots, and scanned pages together in one file: add them all, arrange the order, and download a single document.',
    },
    {
      h: 'Archiving at full quality',
      p: 'PNG and JPEG files are embedded as-is, so nothing is recompressed. Fit-to-image pages keep each picture at its exact dimensions.',
    },
  ]}
>
  <section class="tool-card" slot="tool" aria-label="Images to PDF tool">
    <div id="dropzone" class="dropzone" tabindex="0" role="button" aria-label="Add images to convert">
      <div class="dz-icon"><Icon name="upload" size={30} /></div>
      <div class="dz-title">Drop images here</div>
      <div class="dz-sub">or click to choose files &middot; any image format &middot; they stay on your device</div>
    </div>
    <input type="file" id="file-input" multiple hidden />
    <div id="error-box" class="error-box" hidden></div>
    <ul id="file-list" class="file-list"></ul>
    <p id="empty-state" class="empty-state">No images yet. Add your images above, then arrange them in page order.</p>
    <p class="hint">Tip: drag a row to move it, or paste screenshots straight from your clipboard (Ctrl+V).</p>
    <div class="row-2">
      <div class="field">
        <label for="page-size">Page size</label>
        <select id="page-size">
          <option value="fit">Fit to image (each page matches its image)</option>
          <option value="a4">A4 (images scaled to fit)</option>
          <option value="letter">US Letter (images scaled to fit)</option>
        </select>
      </div>
      <div class="field" id="orientation-field" hidden>
        <label for="orientation">Orientation</label>
        <select id="orientation">
          <option value="auto" selected>Match each image</option>
          <option value="portrait">Portrait (tall)</option>
          <option value="landscape">Landscape (wide)</option>
        </select>
      </div>
    </div>
    <div class="field" id="margin-field" hidden>
      <label for="margin">Margins</label>
      <select id="margin">
        <option value="slim" selected>Slim</option>
        <option value="none">None (image fills the page)</option>
        <option value="wide">Wide</option>
      </select>
    </div>
    <div class="btn-row">
      <button id="convert-btn" class="btn" disabled>Create PDF</button>
      <span id="count-label" class="count-label"></span>
    </div>
    <div id="result" class="result" hidden>
      <h3>Done</h3>
      <p id="result-info"></p>
      <div id="preview-wrap" class="pdf-preview-wrap" hidden></div>
      <button id="download-btn" class="btn">Download PDF</button>
    </div>
  </section>
  <script>
    import { initImagesToPdf } from '../tools/images-to-pdf';
    initImagesToPdf();
  </script>
</ToolPage>
