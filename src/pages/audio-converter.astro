---
import ToolPage from '../layouts/ToolPage.astro';
import Icon from '../components/Icon.astro';

const title = 'Audio Converter - MP3, WAV, OGG Online Free | GratisBench';
const description =
  'Convert audio between MP3, WAV, and OGG Vorbis online for free. Real encoding in your browser with ffmpeg.wasm. No signup, no watermark. Your audio never leaves your device.';
const h1 = 'Convert audio files';
const lede = 'Turn audio between MP3, WAV, and OGG Vorbis. Real encoding, on your device, no upload queues.';
---
<ToolPage
  title={title}
  description={description}
  h1={h1}
  lede={lede}
  crumbs={[{ label: 'Media tools', href: '/media-tools' }, { label: 'Audio converter', href: '/audio-converter' }]}
  toolName="GratisBench Audio Converter"
  intro={[
    'Audio conversion online usually means uploading your file to a stranger\'s server, waiting in a queue behind everyone else\'s files, and hoping the result is what the button promised. This converter never uploads anything. It runs a real copy of ffmpeg, the same encoder professionals use, compiled to WebAssembly and running inside your tab. The file goes in, the conversion happens on your device, and the result downloads straight to you.',
    'The first conversion takes a moment because the encoder itself, about 30MB, downloads once and is then cached by your browser. After that, conversions start immediately. MP3 uses the well-known LAME encoder, OGG uses Vorbis, and WAV is written as plain 16-bit PCM. Bitrate is your choice for the lossy formats, so you control the tradeoff between file size and sound quality.',
    'One honest boundary: this tool converts between common formats, it does not improve audio. Converting a low-bitrate MP3 to WAV makes a bigger file, not a better-sounding one. Pick the format that fits the job: MP3 for sharing and players, OGG for open-source projects, WAV for editing and archiving.',
  ]}
  steps={[
    'Drop your audio file onto the box above, or click it to browse. The encoder loads in the background while you choose options.',
    'Pick the output format: MP3, WAV, or OGG Vorbis.',
    'For MP3 or OGG, choose a bitrate. Higher means better sound and a bigger file.',
    'Click "Convert". The conversion runs on your device, with a progress bar.',
    'Download the converted file when it finishes.',
  ]}
  specs={[
    ['Cost', 'Free, no limits'],
    ['Signup', 'None. No account, no email.'],
    ['Watermark', 'None'],
    ['Where files are processed', 'In your browser, on your device'],
    ['Output formats', 'MP3 (LAME), WAV (16-bit PCM), OGG (Vorbis)'],
    ['MP3 / OGG bitrates', '128, 192, or 320 kbps'],
    ['Engine download', 'About 30MB on first use, cached afterwards'],
    ['Works offline', 'Yes, once the page and the engine have loaded'],
  ]}
  faqs={[
    {
      q: 'Is this audio converter really free?',
      a: 'Yes. There is no free tier with a paid tier above it, no daily quota, and no features held back. Conversion runs on your device, so there is no per-file cost to pass on. The converted file downloads with no watermark and no account.',
    },
    {
      q: 'Is my audio uploaded to a server?',
      a: 'No. The conversion runs inside your browser using a WebAssembly build of ffmpeg. Your file never leaves your device, which makes this safe for voice memos, interviews, and unreleased recordings. Closing the tab removes all trace.',
    },
    {
      q: 'Why does the first conversion take longer to start?',
      a: 'The encoder itself is a roughly 30MB download the first time you use any ffmpeg-based tool here. Your browser caches it, so later conversions start right away.',
    },
    {
      q: 'Which format should I choose?',
      a: 'MP3 plays everywhere and is the safe default for sharing. OGG Vorbis sounds slightly better than MP3 at the same bitrate and is fully open, but some players and car stereos skip it. WAV is lossless and best for editing or archiving, at the cost of much larger files.',
    },
    {
      q: 'What bitrate should I pick for MP3 or OGG?',
      a: '128 kbps is fine for voice and casual listening at small sizes. 192 kbps is the sweet spot for music most people cannot distinguish from the original. 320 kbps is near-transparent and worth it if storage is no concern. Going above the source bitrate never adds quality back.',
    },
    {
      q: 'Will converting improve my audio quality?',
      a: 'No. Conversion can only preserve or reduce quality, never improve it. A 128 kbps MP3 converted to WAV is still 128 kbps quality in a bigger file. Convert from the highest-quality source you have, and avoid converting lossy to lossy more than once.',
    },
    {
      q: 'Can it convert video files or DRM-protected music?',
      a: 'Video files are not accepted here; the video converter handles those. DRM-protected files from streaming services cannot be converted by any honest tool, because the protection has to be removed first, which this tool does not do.',
    },
  ]}
>
  <section class="tool-card" slot="tool" aria-label="Audio converter tool">
    <div id="dropzone" class="dropzone" tabindex="0" role="button" aria-label="Add an audio file to convert">
      <div class="dz-icon"><Icon name="audio" size={30} /></div>
      <div class="dz-title">Drop audio here</div>
      <div class="dz-sub">or click to choose a file &middot; it stays on your device</div>
    </div>
    <input type="file" id="file-input" accept="audio/*,.m4a,.ogg,.oga,.flac,.wav,.mp3,.opus,.wma" hidden />
    <div id="error-box" class="error-box" hidden></div>
    <p id="file-info" class="count-label"></p>
    <p id="engine-status" class="engine-status" hidden></p>

    <h3 class="tool-step">Output format</h3>
    <div class="radio-cards" role="radiogroup" aria-label="Output format">
      <label class="radio-card"><input type="radio" name="format" value="mp3" checked /><span><strong>MP3</strong><small>Plays everywhere. LAME encoder.</small></span></label>
      <label class="radio-card"><input type="radio" name="format" value="wav" /><span><strong>WAV</strong><small>Lossless. Big files, best for editing.</small></span></label>
      <label class="radio-card"><input type="radio" name="format" value="ogg" /><span><strong>OGG Vorbis</strong><small>Open format, great quality per bit.</small></span></label>
    </div>

    <div class="field field-narrow" id="quality-row">
      <label for="quality-select">Bitrate</label>
      <select id="quality-select">
        <option value="128">128 kbps</option>
        <option value="192" selected>192 kbps</option>
        <option value="320">320 kbps</option>
      </select>
    </div>

    <div class="btn-row">
      <button id="convert-btn" class="btn" disabled>Convert</button>
    </div>
    <div class="progress-wrap">
      <div class="progress-label" id="progress-label"></div>
      <div class="progress-track"><div class="progress-bar" id="progress-bar"></div></div>
    </div>
    <div id="result" class="result" hidden>
      <h3>Converted</h3>
      <p id="result-info"></p>
    </div>
  </section>
  <script>
    import { initAudioConverter } from '../tools/audio-converter';
    initAudioConverter();
  </script>
</ToolPage>
