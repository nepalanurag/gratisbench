---
import ToolPage from '../layouts/ToolPage.astro';

const title = 'Edit PDF Free — Combine, Organize, Edit Text, Add Page Numbers';
const description =
  'Edit PDFs in your browser: combine multiple PDFs, reorder or delete pages, fix text, add page numbers or watermarks, protect with a password. Free, no signup, files never leave your device.';
const h1 = 'PDF Editor';
const lede = 'Fix your PDF in three steps. No account, no upload, no watermark on your file.';
---
<ToolPage
  title={title}
  description={description}
  h1={h1}
  lede={lede}
  crumbs={[{ label: 'PDF tools', href: '/pdf-tools' }, { label: 'PDF Editor', href: '/pdf-editor' }]}
  toolName="TruePDF PDF Editor"
  intro={[
    'Combine bank statements for a loan application. Fix a typo in a contract before signing. Add page numbers to a report. Delete the blank pages from a scan.',
    'Drop your PDF below. Your pages appear as pictures you can drag into order, rotate, or delete. Tap a page to fix its text. Add page numbers, a watermark, or a password when you need them. Everything happens in your browser — your file never goes to a server.',
  ]}
  steps={[
    'Drop your PDF onto the box below, or tap it to browse. You can add more PDFs any time.',
    'Drag the page pictures to reorder them. Tap a picture to open it and fix the text. Use the buttons to add page numbers, a watermark, or a password.',
    'Tap "Download PDF". Your file saves to your device with every change applied.',
  ]}
  specs={[
    ['Cost', 'Free, no limits'],
    ['Signup', 'None. No account, no email.'],
    ['Your files', 'Never leave your device. Everything runs in your browser.'],
    ['Combine PDFs', 'Drop in more files; their pages join the list'],
    ['Organize', 'Drag pages to reorder, tap to rotate or delete'],
    ['Fix text', 'Tap a page, tap the text, type the correction'],
    ['Add to pages', 'Page numbers, watermark, header and footer'],
    ['Protect', 'Add a password to the download'],
    ['Works offline', 'Yes, once the page has loaded'],
  ]}
  faqs={[
    {
      q: 'Is this really free?',
      a: 'Yes. No paid tier, no daily limits, no watermark on your file. Everything runs in your browser, so there is nothing to charge for.',
    },
    {
      q: 'Do my PDFs get uploaded anywhere?',
      a: 'No. Your files never leave your device. This makes it safe for contracts, medical records, bank statements, and anything else sensitive.',
    },
    {
      q: 'How do I fix a typo in my PDF?',
      a: 'Tap the page picture to open it, then tap the text you want to change and type. The fix appears in the same spot as the original text. Best for short fixes like names and dates.',
    },
    {
      q: 'Can I undo if I make a mistake?',
      a: 'Yes. Tap Undo (or Ctrl+Z) to reverse reorders, rotations, deletions, and added files, right up until you download.',
    },
    {
      q: 'Can I open a password-protected PDF?',
      a: 'Unlock it first with the Unlock PDF tool, then open it here.',
    },
  ]}
  usecases={[
    { h: 'Combine files for a loan application', p: 'Drop in your bank statements, pay slips, and ID. Drag them into order, download one PDF.' },
    { h: 'Fix a typo in a contract', p: 'Open the page, tap the wrong name or date, type the correction. No need to ask for a new copy.' },
    { h: 'Clean up a scan', p: 'Delete the blank pages, rotate the sideways ones, crop the dark edges, add page numbers.' },
  ]}
>
  <section class="tool-card" slot="tool" aria-label="PDF editor workspace">
    <div id="error-box" class="error-box" hidden></div>

    <div id="ws-dropzone" class="dropzone" role="button" tabindex="0" aria-label="Drop PDF files here or tap to browse">
      <p class="dz-title">Drop your PDFs here</p>
      <p class="dz-sub">or tap to browse — files never leave your device</p>
      <input type="file" id="ws-file-input" accept="application/pdf,.pdf" multiple hidden />
    </div>
    <p id="size-note" class="hint" hidden></p>

    <div id="ws-toolbar" class="ws-toolbar" hidden>
      <div class="ws-toolbar-row">
        <button id="ws-add" class="btn btn-secondary" type="button">Add PDFs</button>
        <button id="ws-undo" class="btn btn-secondary" type="button" disabled>Undo</button>
        <span class="ws-sep"></span>
        <button id="ws-rotate" class="btn btn-secondary" type="button" disabled>Rotate</button>
        <button id="ws-delete" class="btn btn-secondary" type="button" disabled>Delete</button>
        <button id="ws-extract" class="btn btn-secondary" type="button" disabled>Save selected pages</button>
        <span class="ws-sep"></span>
        <button id="ws-text" class="btn btn-secondary" type="button" disabled>Fix text</button>
        <button id="ws-crop" class="btn btn-secondary" type="button" disabled>Crop</button>
      </div>
      <div class="ws-toolbar-row">
        <button id="ws-watermark" class="btn btn-secondary" type="button">Watermark</button>
        <button id="ws-pagenum" class="btn btn-secondary" type="button">Page numbers</button>
        <button id="ws-headerfooter" class="btn btn-secondary" type="button">Header & footer</button>
        <button id="ws-protect" class="btn btn-secondary" type="button">Add password</button>
        <span class="ws-sep"></span>
        <button id="ws-download" class="btn" type="button">Download PDF</button>
      </div>
      <p id="ws-status" class="ws-status"></p>
    </div>

    <div id="ws-grid" class="ws-grid" hidden aria-label="Page thumbnails"></div>

    <div id="ws-pageview" class="ws-pageview" hidden>
      <div class="ws-pv-bar">
        <button id="ws-pv-back" class="btn btn-secondary" type="button">Back to pages</button>
        <span id="ws-pv-label" class="ws-pv-label"></span>
        <button id="ws-pv-crop" class="btn btn-secondary" type="button">Crop this page</button>
      </div>
      <p class="hint" id="ws-pv-hint">Tap any text on the page to fix it.</p>
      <div id="ws-pv-stage" class="ws-pv-stage"></div>
    </div>

    <div id="ws-dialog" class="ws-dialog" hidden>
      <div class="ws-dialog-card" role="dialog" aria-modal="true" aria-labelledby="ws-dialog-title">
        <h3 id="ws-dialog-title"></h3>
        <div id="ws-dialog-body"></div>
        <div class="btn-row">
          <button id="ws-dialog-ok" class="btn" type="button">Apply</button>
          <button id="ws-dialog-cancel" class="btn btn-secondary" type="button">Cancel</button>
        </div>
      </div>
    </div>
  </section>

  <script>
    import { initPdfWorkspace } from '../tools/pdf-workspace';
    try {
      initPdfWorkspace();
    } catch (err) {
      const box = document.getElementById('error-box');
      if (box) {
        box.hidden = false;
        box.textContent = 'The PDF editor could not start in this browser. Please use a recent version of Chrome, Edge, Firefox, or Safari.';
      }
    }
  </script>
</ToolPage>
