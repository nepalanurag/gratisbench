---
import ToolPage from '../layouts/ToolPage.astro';
import Icon from '../components/Icon.astro';
import ToolkitTabs from '../components/ToolkitTabs.astro';

const title = 'Video Converter - MP4, WebM, MOV Online Free | TruePDF';
const description =
  'Convert video between MP4, WebM, and MOV online for free. No signup, no watermark. Your video never leaves your device.';
const h1 = 'Convert videos';
const lede = 'Turn video between MP4, WebM, and MOV, right on your device. No upload queues.';
---
<ToolPage
  title={title}
  description={description}
  h1={h1}
  lede={lede}
  crumbs={[{ label: 'Media tools', href: '/media-tools' }, { label: 'Video converter', href: '/video-converter' }]}
  toolName="TruePDF Video Converter"
  intro={[
    'Video conversion online usually means uploading a large file to a server, waiting in a queue, and getting back a file with a watermark unless you pay. This converter does the whole job in your browser instead. The file never leaves your device, there is no queue, and the download is yours with nothing stamped on it.',
    'Three formats cover nearly every real-world need. MP4 is the universal choice: it plays on phones, browsers, TVs, and editing software without a second thought. WebM is the web-native open format, great for embedding video on your own site. MOV is Apple\'s format, handy when a Mac workflow or an old device specifically asks for it.',
  ]}
  steps={[
    'Drop your video onto the box above, or click it to browse.',
    'Pick the output format: MP4, WebM, or MOV.',
    'Click "Convert video". The conversion runs on your device with a progress bar.',
    'Download the converted file when it finishes.',
  ]}
  specs={[
    ['Cost', 'Free, no limits'],
    ['Signup', 'None. No account, no email.'],
    ['Watermark', 'None'],
    ['Where files are processed', 'In your browser, on your device'],
    ['Output formats', 'MP4, WebM, MOV'],
    ['Sound', 'Kept as-is, or removed with the "Remove the sound" option'],
    ['Quality', 'High quality, visually close to the original'],
    ['First load', 'About 30 MB one time, cached afterwards'],
    ['Works offline', 'Yes, once the page has fully loaded'],
  ]}
  faqs={[
    {
      q: 'Is this video converter really free?',
      a: 'Yes. There is no free tier with a paid tier above it, no daily quota, and no features held back. Conversion runs on your device, so there is no per-minute encoding cost to pass on. The converted file downloads with no watermark and no account.',
    },
    {
      q: 'Is my video uploaded to a server?',
      a: 'No. The conversion happens inside your browser. Your video never leaves your device, which matters for screen recordings and personal footage. Closing the tab removes all trace of the file.',
    },
    {
      q: 'Which format should I choose?',
      a: 'MP4 is the safe default: it plays on every phone, browser, TV, and editor. Choose WebM when you are embedding video on a website and want the open web-native format with good compression. Choose MOV when a Mac workflow, an Apple device, or specific software asks for it by name.',
    },
    {
      q: 'How long will conversion take?',
      a: 'Longer than a desktop app. A one-minute clip takes a few minutes on a decent laptop. The progress bar shows where it is, and the tab must stay open.',
    },
    {
      q: 'Will converting reduce the video quality?',
      a: 'Slightly. The tool keeps the quality high, so the result looks the same as the source for almost everyone. Converting an already-compressed file always loses a little; starting from the original camera file gives the best result.',
    },
    {
      q: 'Can I remove the audio from a video?',
      a: 'Yes. Tick "Remove the sound" before converting and the output plays silently. Useful for GIF-style clips or footage where the audio is just noise. Removing the sound also makes the file a little smaller.',
    },
    {
      q: 'Can it convert between any formats, like AVI or MKV input?',
      a: 'Most common inputs work: MP4, WebM, MOV, MKV, AVI, and phone formats. Outputs are limited to MP4, WebM, and MOV. If your input will not read, it is probably in a format the tool does not support.',
    },
  ]}
>
  <ToolkitTabs
    current="/video-converter"
    tabs={[
      { href: '/video-compressor', label: 'Compress' },
      { href: '/video-trimmer', label: 'Trim' },
      { href: '/video-converter', label: 'Convert' },
      { href: '/subtitle-editor', label: 'Subtitles' },
    ]}
  />
  <section class="tool-card" slot="tool" aria-label="Video converter tool">
    <div id="dropzone" class="dropzone" tabindex="0" role="button" aria-label="Add a video to convert">
      <div class="dz-icon"><Icon name="video" size={30} /></div>
      <div class="dz-title">Drop video here</div>
      <div class="dz-sub">or click to choose a file &middot; it stays on your device</div>
    </div>
    <input type="file" id="file-input" accept="video/*,.mkv,.mov,.webm,.mp4,.m4v,.avi" hidden />
    <div id="error-box" class="error-box" hidden></div>
    <p id="file-info" class="count-label"></p>
    <p id="size-note" class="hint" hidden></p>
    <p id="engine-status" class="engine-status" hidden></p>

    <h3 class="tool-step">Output format</h3>
    <div class="radio-cards" role="radiogroup" aria-label="Output format">
      <label class="radio-card"><input type="radio" name="format" value="mp4" checked /><span><strong>MP4</strong><small>Plays everywhere.</small></span></label>
      <label class="radio-card"><input type="radio" name="format" value="webm" /><span><strong>WebM</strong><small>Open format for the web.</small></span></label>
      <label class="radio-card"><input type="radio" name="format" value="mov" /><span><strong>MOV</strong><small>For Apple workflows.</small></span></label>
    </div>
    <div class="field" id="fastcopy-row" hidden>
      <label class="checkline"><input type="checkbox" id="fastcopy-check" checked /> <span><strong>Fast copy.</strong> Your file is already in this format, so it can be converted much faster with no quality loss. Uncheck to force a full conversion.</span></label>
    </div>

    <h3 class="tool-step">Playback speed</h3>
    <div class="radio-cards" role="radiogroup" aria-label="Playback speed">
      <label class="radio-card"><input type="radio" name="speed" value="0.5" /><span><strong>0.5×</strong><small>Half speed, slow motion.</small></span></label>
      <label class="radio-card"><input type="radio" name="speed" value="1" checked /><span><strong>1×</strong><small>Normal speed.</small></span></label>
      <label class="radio-card"><input type="radio" name="speed" value="1.5" /><span><strong>1.5×</strong><small>Faster.</small></span></label>
      <label class="radio-card"><input type="radio" name="speed" value="2" /><span><strong>2×</strong><small>Double speed.</small></span></label>
    </div>

    <h3 class="tool-step">Aspect ratio</h3>
    <div class="radio-cards" role="radiogroup" aria-label="Aspect ratio">
      <label class="radio-card"><input type="radio" name="aspect" value="original" checked /><span><strong>Original</strong><small>Keep the video's shape.</small></span></label>
      <label class="radio-card"><input type="radio" name="aspect" value="16:9" /><span><strong>16:9</strong><small>Widescreen, YouTube.</small></span></label>
      <label class="radio-card"><input type="radio" name="aspect" value="9:16" /><span><strong>9:16</strong><small>Vertical, Shorts &amp; Reels.</small></span></label>
      <label class="radio-card"><input type="radio" name="aspect" value="1:1" /><span><strong>1:1</strong><small>Square, feeds.</small></span></label>
      <label class="radio-card"><input type="radio" name="aspect" value="4:3" /><span><strong>4:3</strong><small>Classic TV shape.</small></span></label>
    </div>

    <h3 class="tool-step">Sound</h3>
    <div class="field">
      <label class="checkline"><input type="checkbox" id="mute-check" /> <span><strong>Remove the sound.</strong> The converted video plays silently. Handy for GIF-style clips, or when the audio is just background noise.</span></label>
    </div>

    <div class="btn-row">
      <button id="convert-btn" class="btn" disabled>Convert video</button>
    </div>
    <div id="progress-wrap" class="progress-wrap" hidden>
      <div class="progress-label" id="progress-label"></div>
      <div class="progress-track"><div class="progress-bar" id="progress-bar"></div></div>
    </div>
    <div id="result" class="result" hidden>
      <h3>Converted</h3>
      <p id="result-info"></p>
    </div>
  </section>
  <script>
    import { initVideoConverter } from '../tools/video-converter';
    initVideoConverter();
  </script>
</ToolPage>
