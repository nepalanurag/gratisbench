---
import BaseLayout from '../layouts/BaseLayout.astro';
import { basePath, siteUrl } from '../lib/site';
import { TOOL_GROUPS } from '../lib/tools';

const title = 'FreeKit - Free Online Tools That Run in Your Browser';
const description =
  'Free online tools with no signup and no watermarks: budget planner, subscription tracker, logo maker, OG image generator, device mockup generator, resume builder, invoice generator, email signature generator, merge PDF, split PDF, images to PDF, compress PDF, PDF to JPG, redact PDF, sign PDF, compress and convert images, remove backgrounds, image OCR, trace images to SVG, QR code generator, trim and join audio, convert audio, compress/trim/convert video, screen recorder. Your files never leave your device.';

let n = 0;
const groups = TOOL_GROUPS.map((g) => ({
  ...g,
  tools: g.tools.map((t) => ({ ...t, num: String(++n).padStart(2, '0') })),
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'FreeKit',
  url: siteUrl(Astro.site) + basePath('/'),
  description,
};
---
<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="wrap">
    <div class="home-head">
      <h1>Free tools that run in your browser.</h1>
      <p class="intro">
        FreeKit is 32 small tools for everyday file work: PDFs, images, audio,
        video, and a few business basics. They run entirely on your device,
        so there is nothing to upload, no account to create, and no watermark
        on the way out.
      </p>
      <p class="intro">
        I built them because I kept needing them. If a tool breaks, tell me
        and I will fix it.
      </p>
    </div>

    <section class="try-it" aria-label="Try a tool right now">
      <h2>Try one right now.</h2>
      <p class="try-it-sub">A real tool, running on this page. Type something and watch it work.</p>
      <div class="try-it-box">
        <div class="try-it-controls">
          <label for="demo-qr-text">Text or link</label>
          <input
            id="demo-qr-text"
            type="text"
            value="https://nepalanurag.github.io/freekit/"
            maxlength="4000"
            autocomplete="off"
            spellcheck="false"
          />
          <p id="demo-qr-err" class="error-box" hidden></p>
          <div class="try-it-actions">
            <button id="demo-qr-dl" class="btn primary" type="button">Download PNG</button>
            <a class="link-btn" href={basePath('/qr-generator')}>Full QR generator, with logo and colors</a>
          </div>
        </div>
        <div class="demo-qr-preview">
          <img id="demo-qr-img" alt="QR code for the text you typed" width="440" height="440" hidden />
          <p id="demo-qr-empty" hidden>Type something to make a code.</p>
        </div>
      </div>
    </section>

    <!-- Ad slot: homepage (AdSense display unit goes here) -->
    <div class="ad-slot" data-ad-slot="home-top" aria-hidden="true"><span>Advertisement</span></div>

    <div class="tool-index">
      {groups.map((g) => (
        <section class="tool-group" aria-label={g.name}>
          <div class="tool-group-head">
            <h2>{g.name}</h2>
            <span class="count">{g.tools.length}</span>
          </div>
          {g.tools.map((t) => (
            <a class="tool-row" href={basePath(t.href)}>
              <span class="tool-row-num">{t.num}</span>
              <span>
                <span class="tool-row-name">{t.name}</span>
                <p class="tool-row-desc">{t.desc}</p>
              </span>
              <span class="tool-row-tag">{t.tag}</span>
              <span class="arrow" aria-hidden="true">&rarr;</span>
            </a>
          ))}
        </section>
      ))}
    </div>

    <div class="content">
      <div class="plain-facts">
        <h2>Worth knowing</h2>
        <ul>
          <li><strong>Private by construction.</strong> Your files are read and processed on your device. Open the network tab while converting something: nothing leaves.</li>
          <li><strong>No accounts, no quotas.</strong> No signup, no daily limits, no watermarks.</li>
          <li><strong>Works offline.</strong> Once a page has loaded, it keeps working without a connection.</li>
        </ul>
      </div>

      <h2>Common questions</h2>
      <dl>
        <div class="faq">
          <dt>What is FreeKit?</dt>
          <dd>FreeKit is a collection of small, single-purpose web tools: PDF utilities, converters, and generators. Each tool does one job, runs entirely in your browser, and is free without an account.</dd>
        </div>
        <div class="faq">
          <dt>How can the tools be free?</dt>
          <dd>Because there is almost nothing to pay for. The tools run on your device instead of a server, so there are no per-file processing costs. A simple site with no backend is cheap to run, and that saving is passed on as no prices, no quotas, and no watermarks.</dd>
        </div>
        <div class="faq">
          <dt>Are my files really private?</dt>
          <dd>Yes. Open your browser's network tab while using any tool and you will see no file uploads. Your documents are read, processed, and downloaded locally. Closing the tab removes all trace.</dd>
        </div>
      </dl>
    <!-- Ad slot: homepage bottom (AdSense display unit goes here) -->
    <div class="ad-slot" data-ad-slot="home-bottom" aria-hidden="true"><span>Advertisement</span></div>
    </div>
  </div>
  <script>
    import { initHomeDemo } from '../tools/home-demo';
    initHomeDemo();
  </script>
</BaseLayout>
