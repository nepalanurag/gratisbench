---
import BaseLayout from '../layouts/BaseLayout.astro';
import { basePath, siteUrl } from '../lib/site';
import { TOOL_GROUPS } from '../lib/tools';

const title = 'TruePDF — Free PDF Tools Online: Merge, Compress, Convert | No Upload, No Watermark';
const description =
  'Free PDF tools that run entirely in your browser — your files never leave your device. Merge PDF, split PDF, compress PDF, JPG to PDF, PDF to Word, PDF to JPG, redact, sign, unlock, and 20+ more tools. No signup, no watermark, no upload.';

let n = 0;
const groups = TOOL_GROUPS.map((g) => ({
  ...g,
  tools: g.tools.map((t) => ({ ...t, num: String(++n).padStart(2, '0') })),
}));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'TruePDF',
  url: siteUrl(Astro.site) + '/',
  description,
};
---
<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="wrap">
    <div class="home-head">
      <h1>Free PDF tools that never upload your files.</h1>
      <p class="intro">
        TruePDF is 32 small tools for everyday file work: PDFs, images, audio,
        video, and business paperwork. Everything runs on your device, so there
        is nothing to upload, no account to create, and no watermark on the way
        out. I built them because I kept needing them.
      </p>
    </div>

    <section class="try-it" aria-label="Try a tool right now">
      <h2>Try one right now.</h2>
      <p class="try-it-sub">The actual QR generator, running on this page. Type something to make a code.</p>
      <div class="try-it-box">
        <div class="try-it-controls">
          <label for="demo-qr-text">Text or link</label>
          <input
            id="demo-qr-text"
            type="text"
            value="https://truepdf.vercel.app/"
            maxlength="4000"
            autocomplete="off"
            spellcheck="false"
          />
          <p id="demo-qr-err" class="error-box" hidden></p>
          <div class="try-it-actions">
            <button id="demo-qr-dl" class="btn primary" type="button">Download PNG</button>
            <a class="link-btn" href={basePath('/qr-generator')}>Full QR generator, with logo and colors</a>
          </div>
        </div>
        <div class="demo-qr-preview">
          <img id="demo-qr-img" alt="QR code for the text you typed" width="440" height="440" hidden />
          <p id="demo-qr-empty" hidden>Type something to make a code.</p>
        </div>
      </div>
    </section>

    <!-- Ad slot: homepage (AdSense display unit goes here) -->
    <div class="ad-slot" data-ad-slot="home-top" aria-hidden="true"><span>Advertisement</span></div>

    <div class="tool-index">
      {groups.map((g) => (
        <section class="tool-group" aria-label={g.name}>
          <div class="tool-group-head">
            <h2>{g.name}</h2>
            <span class="count">{g.tools.length}</span>
          </div>
          {g.tools.map((t) => (
            <a class="tool-row" href={basePath(t.href)}>
              <span class="tool-row-num">{t.num}</span>
              <span>
                <span class="tool-row-name">{t.name}</span>
                <p class="tool-row-desc">{t.desc}</p>
              </span>
              <span class="tool-row-tag">{t.tag}</span>
              <span class="arrow" aria-hidden="true">&rarr;</span>
            </a>
          ))}
        </section>
      ))}
    </div>

    <div class="content">
      <div class="plain-facts">
        <h2>Worth knowing</h2>
        <ul>
          <li><strong>Private by construction.</strong> Your files are read and processed on your device. Open the network tab while converting something: nothing leaves.</li>
          <li><strong>No accounts, no quotas, no watermarks.</strong> There is no signup wall, no daily limit, and nothing stamped on your output.</li>
          <li><strong>Works offline.</strong> Once a page has loaded, it keeps working without a connection.</li>
        </ul>
      </div>

      <h2>Common questions</h2>
      <dl>
        <div class="faq">
          <dt>What is TruePDF?</dt>
          <dd>A collection of small, single-purpose tools: PDF utilities, converters, and generators. Each does one job, runs in your browser, and is free without an account.</dd>
        </div>
        <div class="faq">
          <dt>How can the tools be free?</dt>
          <dd>There is almost nothing to pay for. The tools run on your device instead of a server, so there are no per-file processing costs and no prices, quotas, or watermarks.</dd>
        </div>
        <div class="faq">
          <dt>Are my files really private?</dt>
          <dd>Yes. Open your browser's network tab while using any tool and you will see no file uploads. Closing the tab removes all trace.</dd>
        </div>
      </dl>
    <!-- Ad slot: homepage bottom (AdSense display unit goes here) -->
    <div class="ad-slot" data-ad-slot="home-bottom" aria-hidden="true"><span>Advertisement</span></div>
    </div>
  </div>
  <script>
    import { initHomeDemo } from '../tools/home-demo';
    initHomeDemo();
  </script>
</BaseLayout>
