---
import BaseLayout from '../layouts/BaseLayout.astro';
import { basePath, siteUrl } from '../lib/site';
import { ALL_TOOLS } from '../lib/tools';

const title = 'Media Tools - Free Online Audio & Video Utilities | TruePDF';
const description =
  'Free online media tools: trim audio, join audio clips, convert audio, compress video, trim video, convert video, and record your screen. No signup, no watermark. Everything runs in your browser.';

const toolsRaw = [
  { href: '/audio-trimmer', name: 'Audio trimmer', desc: 'Cut audio with a waveform editor, precise to a tenth of a second. Export WAV or MP3.' },
  { href: '/audio-merger', name: 'Audio merger', desc: 'Join multiple clips into one file, with fade in/out at each join.' },
  { href: '/audio-converter', name: 'Audio converter', desc: 'Convert between MP3, WAV, and OGG.' },
  { href: '/video-compressor', name: 'Video compressor', desc: 'Shrink video to a target size: 25MB for chat apps, 10MB for email, or custom.' },
  { href: '/video-trimmer', name: 'Video trimmer', desc: 'Cut a section out of a video. Quick cuts or frame-accurate cuts.' },
  { href: '/video-converter', name: 'Video converter', desc: 'Convert video between MP4, WebM, and MOV.' },
  { href: '/subtitle-editor', name: 'Subtitle editor', desc: 'Add subtitles to video. Time captions on the video, preview live, export SRT.' },
  { href: '/screen-recorder', name: 'Screen recorder', desc: 'Record a tab, window, or screen. No time cap, no watermark, mic optional.' },
] as const;

const tagByHref = new Map(ALL_TOOLS.map((t) => [t.href, t.tag]));
const tools = toolsRaw.map((t, i) => ({ ...t, num: String(i + 1).padStart(2, '0'), tag: tagByHref.get(t.href) ?? '' }));

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: 'TruePDF media tools',
  url: siteUrl(Astro.site) + '/media-tools/',
  description,
};
---
<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="wrap">
    <div class="page-head">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={basePath("/")}>TruePDF</a><span><span class="sep">/</span><a href={basePath("/media-tools")}>Media tools</a></span>
      </nav>
      <h1>Media tools</h1>
      <p class="lede">
        Seven utilities for everyday audio and video jobs: trimming clips, joining recordings,
        converting formats, shrinking files to fit chat and email limits, and recording your
        screen. All free, all private, all in your browser.
      </p>
      <p class="privacy-line">Your files never leave your device.</p>
    </div>

    <!-- Ad slot: hub top (AdSense display unit goes here) -->
    <div class="ad-slot" data-ad-slot="hub-top" aria-hidden="true"><span>Advertisement</span></div>

    <div class="tool-index">
      {tools.map((t) => (
        <a class="tool-row" href={basePath(t.href)}>
          <span class="tool-row-num">{t.num}</span>
          <span>
            <span class="tool-row-name">{t.name}</span>
            <p class="tool-row-desc">{t.desc}</p>
          </span>
          <span class="tool-row-tag">{t.tag}</span>
          <span class="arrow" aria-hidden="true">&rarr;</span>
        </a>
      ))}
    </div>

    <div class="content">
      <h2>What these tools do</h2>
      <p>
        The audio tools cover the small jobs: <a href={basePath("/audio-trimmer")}>Audio trimmer</a> cuts
        a section out of a recording with a waveform editor, <a href={basePath("/audio-merger")}>Audio merger</a> joins
        several clips with smooth fades at each join, and <a href={basePath("/audio-converter")}>Audio converter</a> moves
        files between MP3, WAV, and OGG. The video tools handle the heavy jobs, all on your device: <a href={basePath("/video-compressor")}>Video compressor</a> shrinks a file to the size a chat
        app or email will accept, <a href={basePath("/video-trimmer")}>Video trimmer</a> cuts out a section, and{' '}
        <a href={basePath("/video-converter")}>Video converter</a> changes the format.
        <a href={basePath("/screen-recorder")}>Screen recorder</a> captures a tab, window, or screen with no time cap.
      </p>
      <p>
        A useful pattern: record a demo with the screen recorder, trim the dead air off the start with the video
        trimmer, then compress the result to 25MB so it sends in a chat message. Or trim a voice memo, join several
        takes with the merger, and convert the result to MP3 for sharing. Everything stays on your device the whole
        way through.
      </p>

      <h2>Common questions</h2>
      <dl>
        <div class="faq">
          <dt>Are these media tools free?</dt>
          <dd>Yes. All seven tools are free with no limits, no watermarks, and no account. The video tools download roughly 30MB of software on first use, which your browser caches; the tools themselves cost nothing.</dd>
        </div>
        <div class="faq">
          <dt>Do my files get uploaded?</dt>
          <dd>No. All seven tools process your files locally in the browser. Nothing is sent to a server, which is why they also work offline once loaded. The one exception is the video tools' first load, which downloads the tool's own code, not your files.</dd>
        </div>
        <div class="faq">
          <dt>Why is video encoding slow?</dt>
          <dd>Video work in a browser is much slower than in a desktop app. Short clips take minutes; long 4K files can take a very long time. The tools show progress bars and ask you to keep the tab open.</dd>
        </div>
        <div class="faq">
          <dt>Will my files lose quality?</dt>
          <dd>It depends on the job. Trimming and converting audio to WAV are lossless. Compressing video, converting video, and making MP3s all trade some quality for size; the tools use high-quality settings and say plainly where the tradeoff is. Fast video trim copies the video with zero quality change.</dd>
        </div>
      </dl>
    </div>

    <!-- Ad slot: hub bottom (AdSense display unit goes here) -->
    <div class="ad-slot" data-ad-slot="hub-bottom" aria-hidden="true"><span>Advertisement</span></div>
  </div>
</BaseLayout>
