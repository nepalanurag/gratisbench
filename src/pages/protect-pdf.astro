---
import ToolPage from '../layouts/ToolPage.astro';

const title = 'Protect PDF Free — Add Password, No Signup, Files Stay on Device';
const description =
  'Add password protection to a PDF for free. Encrypt your document in the browser; no signup, no watermark, your files never leave your device.';
const h1 = 'Protect PDF';
const lede = 'This tool is now part of the PDF Editor, which protects PDFs and handles every other PDF job in one workspace.';
---
<ToolPage
  title={title}
  description={description}
  h1={h1}
  lede={lede}
  crumbs={[{ label: 'PDF tools', href: '/pdf-tools' }, { label: 'Protect PDF', href: '/protect-pdf' }]}
  toolName="TruePDF Protect PDF"
  intro={[
    'Protecting PDFs now happens inside the PDF Editor. Drop your file there and add password encryption when you download. The same workspace also lets you merge, split, reorder, rotate, delete, edit text, add watermarks and page numbers.',
  ]}
  steps={[]}
  specs={[]}
  faqs={[]}
>
  <div style="text-align: center; padding: 40px 20px;">
    <p style="font-size: 18px; margin-bottom: 20px;">This tool has moved into the PDF Editor.</p>
    <a href="/pdf-editor" style="display: inline-block; padding: 12px 24px; background: var(--accent); color: white; text-decoration: none; border-radius: 6px; font-weight: 600;">Open the PDF Editor</a>
  </div>
  <script>
    setTimeout(() => { window.location.replace('/pdf-editor'); }, 2500);
  </script>
</ToolPage>
