---
import ToolPage from '../layouts/ToolPage.astro';
import Icon from '../components/Icon.astro';

const title = 'Flatten PDF Free — Lock Form Fields Permanently, No Signup';
const description =
  'Flatten a PDF for free, in your browser. Form fields, checkboxes, and dropdowns are baked into the page so answers cannot be changed. No signup, no watermark.';
const h1 = 'Flatten PDF';
const lede = 'Bake a PDF form\u2019s fields into the page. The answers stay visible but can no longer be clicked, edited, or cleared.';
---
<ToolPage
  title={title}
  description={description}
  h1={h1}
  lede={lede}
  crumbs={[{ label: 'PDF tools', href: '/pdf-tools' }, { label: 'Flatten PDF', href: '/flatten-pdf' }]}
  toolName="TruePDF Flatten PDF"
  intro={[
    'A filled form is still a form: anyone who opens it can click a field and change your answers. Flattening bakes every field into the page content. The text, ticks, and choices stay exactly where they are, but they become ordinary print on the page. Nothing can be edited, cleared, or accidentally deleted.',
    'Do this when the form is finished: before sending an application, archiving a record, or sharing a filled document. Keep an unflattened copy for yourself if you might need to edit the answers later, because flattening cannot be undone.',
  ]}
  steps={[
    'Drop one or more filled PDF forms onto the box above, or click it to browse.',
    'The tool counts the form fields in each file that will be baked in.',
    'Click "Flatten". Download each file on its own, or take them all as a ZIP.',
    'Open a result and try clicking a field: nothing should respond.',
  ]}
  specs={[
    ['Cost', 'Free, no limits'],
    ['Signup', 'None. No account, no email.'],
    ['Watermark', 'None.'],
    ['Where files are processed', 'In your browser, on your device'],
    ['Batch', 'Flatten several PDFs at once; download individually or as one ZIP'],
    ['What is flattened', 'Text fields, checkboxes, dropdowns, lists, radio buttons'],
    ['Markups', 'Optional: also remove comments, highlights, and sticky notes'],
    ['What stays the same', 'Everything else: pages, text, images, layout'],
    ['Reversible?', 'No. Keep an unflattened copy if you may edit answers later.'],
    ['Output filename', 'Your original name with "-flattened" added'],
    ['Password-protected PDFs', 'Not supported. Remove the password first, then flatten.'],
  ]}
  faqs={[
    {
      q: 'What does "flatten" actually mean?',
      a: 'The field\u2019s visible answer is painted into the page as ordinary content, and the interactive field behind it is removed. The page looks identical; it just no longer responds to clicks.',
    },
    {
      q: 'When should I flatten a form?',
      a: 'When it is final: sending a job application, submitting paperwork, archiving a completed record. If anyone might still need to change an answer, do not flatten yet.',
    },
    {
      q: 'Can I unflatten a PDF?',
      a: 'No. Flattening is permanent. Keep your fillable original somewhere safe and flatten a copy.',
    },
    {
      q: 'Does flattening shrink the file?',
      a: 'Sometimes slightly, since the form structure is removed. Do not flatten to save space though; the Compress PDF tool is for that.',
    },
    {
      q: 'My PDF has no form fields. Will this do anything?',
      a: 'Flattening alone does nothing for it, and the tool says so instead of pretending. But if you tick "Also remove comments, highlights, and sticky notes", the file still goes through that cleanup pass.',
    },
    {
      q: 'Does this lock the whole PDF against editing?',
      a: 'It locks the form fields. Someone with a PDF editor could still edit other page content. If you need the whole document locked down, that is a different job (printing to a fresh PDF or image-based conversion).',
    },
  ]}
  usecases={[
    {
      h: 'Sending a finished application',
      p: 'Fill the form, flatten it, send it. The recipient sees your answers exactly as you left them and cannot alter them.',
    },
    {
      h: 'Archiving completed paperwork',
      p: 'A flattened form is a record, not a worksheet. Archive it knowing the answers are fixed.',
    },
    {
      h: 'Sharing a filled form publicly',
      p: 'Flatten before publishing so readers get a document, not an editable form with your half-typed drafts in its fields.',
    },
  ]}
>
  <section class="tool-card" slot="tool" aria-label="Flatten PDF tool">
    <div id="dropzone" class="dropzone" tabindex="0" role="button" aria-label="Add PDF forms to flatten">
      <div class="dz-icon"><Icon name="upload" size={30} /></div>
      <div class="dz-title">Drop PDF forms here</div>
      <div class="dz-sub">or click to choose files &middot; it stays on your device</div>
    </div>
    <input type="file" id="file-input" accept="application/pdf,.pdf" multiple hidden />
    <p id="size-note" class="hint" hidden></p>
    <div id="error-box" class="error-box" hidden></div>

    <p class="honest-note">
      <strong>How this works:</strong> every form field is painted into the page as ordinary
      content and the interactive field is removed. This cannot be undone, so keep your original.
    </p>

    <p id="file-info" class="empty-state">Drop one or more PDF forms above to flatten their fields.</p>

    <div id="files-wrap" hidden>
      <div id="file-list" class="flat-list"></div>
      <div class="checkline" style="margin-top:1rem;">
        <input type="checkbox" id="opt-annots" />
        <label for="opt-annots">Also remove comments, highlights, and sticky notes</label>
      </div>
      <div class="btn-row">
        <button id="flatten-btn" class="btn">Flatten</button>
        <button id="zip-btn" class="btn btn-secondary" disabled>Download all as ZIP</button>
      </div>
    </div>

    <div id="result" class="result" hidden>
      <h3>Flattened</h3>
      <p id="result-info"></p>
    </div>
  </section>
  <script>
    import { initFlattenPdf } from '../tools/flatten-pdf';
    initFlattenPdf();
  </script>
  <style>
    /* Page-local styles for the batch file list. */
    :global(.flat-list) {
      display: grid;
      gap: 0.6rem;
      margin: 1rem 0;
    }
    :global(.flat-file) {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 0.6rem 0.8rem;
      background: var(--paper);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.8rem;
      flex-wrap: wrap;
    }
    :global(.flat-file-info) {
      display: grid;
      gap: 0.15rem;
      min-width: 0;
    }
    :global(.flat-file-info strong) {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    :global(.flat-file-sub) {
      font-size: 0.85rem;
      color: var(--muted);
    }
    :global(.flat-file-right) {
      display: inline-flex;
      align-items: center;
      gap: 0.6rem;
    }
    :global(.flat-status) {
      font-size: 0.85rem;
      color: var(--muted);
    }
    :global(.btn-small) {
      padding: 0.4rem 0.8rem;
      font-size: 0.85rem;
    }
  </style>
</ToolPage>
