---
import ToolPage from '../layouts/ToolPage.astro';
import Icon from '../components/Icon.astro';

const title = 'Compress PDF - Free Online PDF Compressor';
const description =
  'Reduce a PDF file size for free, right in your browser. Embedded images are shrunk while text stays sharp and selectable. No signup, no watermark.';
const h1 = 'Compress PDF files';
const lede = 'Make a PDF smaller by shrinking its images. Text stays sharp and selectable. Free, no account, no watermark.';
---
<ToolPage
  title={title}
  description={description}
  h1={h1}
  lede={lede}
  crumbs={[{ label: 'PDF tools', href: '/pdf-tools' }, { label: 'Compress PDF', href: '/pdf-compressor' }]}
  toolName="TruePDF Compress PDF"
  intro={[
    'PDFs get heavy fast. A scanned contract, a slide deck exported with full-resolution images, a phone scan saved at maximum quality: each one can be tens of megabytes, which is awkward when the email server caps attachments at 10 MB or the upload form rejects anything bigger. The usual fix is an online compressor, and the usual price is your document sitting on someone else\u2019s server.',
    'This compressor takes a different approach from most. Instead of rebuilding every page as a flat image, it shrinks only the embedded images \u2014 photos, scans, screenshots \u2014 and leaves everything else exactly as it is. Text, vector graphics, fonts, and links stay sharp at any zoom, and the text remains selectable and searchable.',
    'Everything happens on your device. The images are shrunk locally, the smaller PDF is built locally, and nothing is uploaded anywhere. Your original file is never modified; the download is a separate new file, so you can compare the two and keep whichever you prefer.',
  ]}
  steps={[
    'Drop your PDF onto the box above, or tap it to browse. One file at a time.',
    'Choose how much to shrink: Light (barely noticeable), Medium (best for email), or Heavy (smallest files). Or pick "Hit a file size" and type the size you need.',
    'Tap "Compress PDF". Each large image is shrunk, with a progress bar.',
    'Compare the original and compressed sizes, then download the smaller file.',
  ]}
  specs={[
    ['Cost', 'Free, no limits'],
    ['Signup', 'None. No account, no email.'],
    ['Watermark', 'None. The output is your pages, nothing added.'],
    ['Where files are processed', 'In your browser, on your device'],
    ['How it shrinks files', 'Shrinks the images inside the PDF; text and links stay untouched'],
    ['Text selection', 'Preserved. Selectable, searchable, copyable.'],
    ['Best for', 'PDFs with large photos, scans, or screenshots'],
    ['Less useful for', 'Text-only PDFs, which are usually already small'],
    ['Quality levels', 'Light (barely noticeable), Medium (best for email), or Heavy (smallest files)'],
    ['Output filename', 'Your original name with "-compressed" added'],
  ]}
  faqs={[
    {
      q: 'Will compressing make my PDF blurry?',
      a: 'Text and vector graphics are never touched, so they stay perfectly sharp at any zoom. Only embedded images are shrunk: Light (2400px) is barely noticeable, Medium (1600px) is the sweet spot for screen reading and email, and Heavy (1000px) trades some visible softness on close zoom for the smallest files.',
    },
    {
      q: 'Is the text still selectable after compression?',
      a: 'Yes. This compressor never flattens pages: it shrinks the embedded images and leaves the text exactly as it was. Text stays selectable, searchable, and copyable in the output.',
    },
    {
      q: 'Why did my file barely get smaller?',
      a: 'Two common reasons. First, text-based PDFs are already compact; there is little image data to shrink. Second, the images in the file may already be small, or the PDF may already be optimized. If the result is not meaningfully smaller, the honest answer is that your file was already fine.',
    },
    {
      q: 'Which level should I choose?',
      a: 'Medium is the right starting point for emailing, uploading to a form, or reading on screen. Pick Light if the PDF still needs to look its best when printed or zoomed in, and Heavy when you are fighting a strict upload limit and every kilobyte counts. Your original file is never touched, so you can try all three and compare.',
    },
    {
      q: 'Can I compress several PDFs at once?',
      a: 'The tool handles one PDF per run, which keeps the interface simple and memory use predictable. For a batch, just run it once per file; each run takes only a few seconds on a typical document.',
    },
    {
      q: 'Are my PDFs uploaded to a server?',
      a: 'No. The shrinking happens entirely in your browser. Your files never leave your device, which also means the tool keeps working offline once the page has loaded.',
    },
    {
      q: 'Can it compress a password-protected PDF?',
      a: 'No. Encrypted PDFs cannot be opened without the password. Remove the password in your PDF reader first, then compress the unlocked file.',
    },
  ]}
>
  <section class="tool-card" slot="tool" aria-label="Compress PDF tool">
    <div id="dropzone" class="dropzone" tabindex="0" role="button" aria-label="Add a PDF file to compress">
      <div class="dz-icon"><Icon name="upload" size={30} /></div>
      <div class="dz-title">Drop a PDF here</div>
      <div class="dz-sub">or tap to choose a file &middot; it stays on your device</div>
    </div>
    <input type="file" id="file-input" accept="application/pdf,.pdf" hidden />
    <div id="error-box" class="error-box" hidden></div>
    <p id="file-info" class="count-label"></p>

    <div class="field">
      <label>How should it shrink?</label>
      <div class="radio-cards" role="radiogroup" aria-label="Compression mode">
        <label class="radio-card">
          <input type="radio" name="cmode" value="quality" checked />
          <span><strong>Pick a quality</strong><small>Light, Medium, or Heavy below.</small></span>
        </label>
        <label class="radio-card">
          <input type="radio" name="cmode" value="target" />
          <span><strong>Hit a file size</strong><small>Type a size, we aim under it.</small></span>
        </label>
      </div>
    </div>

    <div class="field" id="target-size-field" hidden>
      <label for="target-mb">Target size (MB)</label>
      <input type="number" id="target-mb" min="0.1" step="0.1" value="2" style="max-width: 160px" />
      <p class="hint">We try lighter settings first and go stronger until the file fits. If it cannot fit, we tell you the smallest we managed.</p>
    </div>

    <div class="field" id="quality-field">
      <label>Quality</label>
      <div class="radio-cards" role="radiogroup" aria-label="Compression level">
        <label class="radio-card">
          <input type="radio" name="level" value="light" />
          <span><strong>Light</strong><small>Images up to 2400px. Barely noticeable.</small></span>
        </label>
        <label class="radio-card">
          <input type="radio" name="level" value="medium" checked />
          <span><strong>Medium</strong><small>Images up to 1600px. Best for email and uploads.</small></span>
        </label>
        <label class="radio-card">
          <input type="radio" name="level" value="heavy" />
          <span><strong>Heavy</strong><small>Images up to 1000px. Smallest files.</small></span>
        </label>
      </div>
    </div>

    <p class="honest-note">
      <strong>Heads up:</strong> only embedded images are touched. Text and vector
      graphics stay exactly as they are — sharp and selectable.
    </p>

    <div id="progress-wrap" class="progress-wrap" hidden>
      <div id="progress-label" class="progress-label"></div>
      <div class="progress-track"><div id="progress-bar" class="progress-bar"></div></div>
    </div>

    <div class="btn-row">
      <button id="compress-btn" class="btn" disabled>Compress PDF</button>
    </div>
    <div id="result" class="result" hidden>
      <h3>Compressed</h3>
      <p id="result-info"></p>
      <div id="preview-wrap" class="pdf-preview-wrap" hidden></div>
      <button id="download-btn" class="btn">Download PDF</button>
    </div>
  </section>
  <script>
    import { initPdfCompressor } from '../tools/pdf-compressor';
    initPdfCompressor();
  </script>
</ToolPage>
