---
import ToolPage from '../layouts/ToolPage.astro';
import Icon from '../components/Icon.astro';

const title = 'Unlock PDF - Remove Password from PDF Online';
const description =
  'Remove password protection from a PDF when you know the password. Free, no signup, no watermark. Your files never leave your browser.';
const h1 = 'Unlock a PDF';
const lede = 'Remove the password from a PDF you own. You need to know the password; this is not a cracker. Free, no account.';
---
<ToolPage
  title={title}
  description={description}
  h1={h1}
  lede={lede}
  crumbs={[{ label: 'PDF tools', href: '/pdf-tools' }, { label: 'Unlock PDF', href: '/unlock-pdf' }]}
  toolName="FreeKit Unlock PDF"
  intro={[
    'A password-protected PDF is a small daily annoyance: you set the password yourself two years ago, or a bank sent you a statement locked with one, and now every open means typing it again. Some tools that remove the password want you to upload the file first, which is exactly the wrong trade for a document you bothered to lock.',
    'This tool removes the password on your device. Give it the file and the password, and it writes out a new PDF with no password on it. The content is untouched: same pages, same text, same quality. If the password is wrong, it tells you plainly instead of producing a broken file.',
    'One honest limit: you must know the password. This tool cannot guess, brute-force, or otherwise crack a password you do not have. That is deliberate.',
  ]}
  steps={[
    'Drop your locked PDF onto the box above, or click it to browse.',
    'Type the password you use to open the file.',
    'Click "Unlock PDF". The unlocked file is built on your device.',
    'Download it. The new file opens with no password.',
  ]}
  specs={[
    ['Cost', 'Free, no limits'],
    ['Signup', 'None. No account, no email.'],
    ['Watermark', 'None'],
    ['Where files are processed', 'In your browser, on your device'],
    ['Requirement', 'You must know the password. This tool cannot crack unknown passwords.'],
    ['Output', 'A new PDF with identical pages and no password'],
    ['Max file size', 'Limited by your device memory; typical documents are fine'],
  ]}
  faqs={[
    {
      q: 'Can this unlock a PDF if I forgot the password?',
      a: 'No. The password is the key that decrypts the file, and without it the content is unreadable by design. This tool only removes protection when you supply the correct password. Anything claiming to recover a lost PDF password is either guessing common passwords or misleading you.',
    },
    {
      q: 'Is my file uploaded anywhere?',
      a: 'No. The file is read into your browser memory, decrypted there, and the unlocked copy is generated there too. Nothing leaves your device.',
    },
    {
      q: 'Will the unlocked PDF look exactly the same?',
      a: 'Yes. Unlocking only removes the encryption wrapper; the pages, text, images, and links are byte-identical in content. The file size may change slightly because the encryption overhead is gone.',
    },
    {
      q: 'My PDF opens without a password but still asks for one when I try to print. Will this fix it?',
      a: 'Usually yes. That is an owner password restricting actions like printing or copying while leaving viewing open. If you can open the file, supply the password you have (or leave it blank and try) and the output will carry no restrictions.',
    },
  ]}
>
  <section class="tool-card" slot="tool" aria-label="Unlock PDF tool">
    <div id="dropzone" class="dropzone" tabindex="0" role="button" aria-label="Add a locked PDF to unlock">
      <div class="dz-icon"><Icon name="lock" size={30} /></div>
      <div class="dz-title">Drop your locked PDF here</div>
      <div class="dz-sub">or click to choose a file &middot; it stays on your device</div>
    </div>
    <input type="file" id="file-input" accept="application/pdf,.pdf" hidden />
    <p id="file-label" class="count-label" role="status"></p>
    <div class="field">
      <label for="pass-input">PDF password</label>
      <input type="password" id="pass-input" autocomplete="off" placeholder="The password you use to open the file" />
    </div>
    <div id="error-box" class="error-box" hidden></div>
    <div class="btn-row">
      <button id="unlock-btn" class="btn" type="button" disabled>Unlock PDF</button>
    </div>
    <div id="result" class="result" hidden>
      <h3>Unlocked</h3>
      <p id="result-info"></p>
      <div id="preview-wrap" class="pdf-preview-wrap" hidden></div>
      <button id="download-btn" class="btn" type="button">Download PDF</button>
    </div>
  </section>
  <script>
    import { initUnlockPdf } from '../tools/unlock-pdf';
    initUnlockPdf();
  </script>
</ToolPage>
