---
import ToolPage from '../layouts/ToolPage.astro';
import Icon from '../components/Icon.astro';
import ToolkitTabs from '../components/ToolkitTabs.astro';

const title = 'Video Trimmer - Cut Video Online Free | TruePDF';
const description =
  'Trim videos online for free. Pick the part to keep on a visual timeline. MP4 output, no signup, no watermark. Your video never leaves your browser.';
const h1 = 'Trim videos';
const lede = 'Cut the start, the end, or middle sections out of a video, right in your browser.';
---
<ToolPage
  title={title}
  description={description}
  h1={h1}
  lede={lede}
  crumbs={[{ label: 'Media tools', href: '/media-tools' }, { label: 'Video trimmer', href: '/video-trimmer' }]}
  toolName="TruePDF Video Trimmer"
  intro={[
    'Most online trimmers make you upload your video and wait. This one runs on your device. Nothing is uploaded. You pick the part to keep on a timeline, and the cut lands where you put it.',
    'Drag the two handles to set your start and end. The video preview follows as you drag, so you can see exactly what you are keeping. If you would rather type, the boxes are forgiving: seconds, 1:30, and 1m30s all work. To remove a middle section instead, switch to "Cut parts out" and mark each part to remove; the rest is joined back into one video. The tool picks the quickest way to make your cut, and most trims finish in seconds.',
    'The result is a plain MP4 that plays everywhere. No watermark. No account. Your original file is never changed; the trimmed copy downloads as a new file.',
  ]}
  steps={[
    'Drop your video onto the box above, or click it to browse. A preview appears with the video length.',
    'Choose "Keep one part" and drag the two handles on the timeline, or choose "Cut parts out" and mark the sections to remove. The preview follows as you work.',
    'You can also type the start and end times in the boxes instead of dragging.',
    'Click "Trim video". The trim runs on your device, so nothing is uploaded.',
    'Download the trimmed MP4.',
  ]}
  specs={[
    ['Cost', 'Free, no limits'],
    ['Signup', 'None. No account, no email.'],
    ['Watermark', 'None'],
    ['Where files are processed', 'In your browser, on your device'],
    ['Modes', 'Keep one part, or cut several parts out and join the rest'],
    ['Output', 'MP4 video'],
    ['Engine download', 'About 30MB on first use, cached afterwards'],
    ['Works offline', 'Yes, once the page and the engine have loaded'],
  ]}
  faqs={[
    {
      q: 'Is this video trimmer really free?',
      a: 'Yes. There is no free tier with a paid tier above it, no daily quota, and no features held back. Trimming runs on your device, so there is no per-minute cost to pass on. The trimmed video downloads with no watermark and no account.',
    },
    {
      q: 'Is my video uploaded to a server?',
      a: 'No. The trim runs inside your browser using ffmpeg. Your video never leaves your device, which matters for screen recordings and personal footage. Closing the tab removes all trace of the file.',
    },
    {
      q: 'How do I choose the part to keep?',
      a: 'Drag the two handles on the timeline. The highlighted section is what you keep, and the preview jumps to each cut point as you drag it. You can also click anywhere on the timeline to preview that spot, or type the start and end times in the boxes below.',
    },
    {
      q: 'How long does trimming take?',
      a: 'Most trims finish in seconds. A cut in the middle of a long video can take a few minutes, because the tool reworks that section so the cut lands exactly where you set it. The progress bar shows where it is. Keep the tab open until it finishes.',
    },
    {
      q: 'Will trimming reduce the video quality?',
      a: 'Usually not. When the cut lands on a clean spot, the video data is copied as is, so the picture is identical to the source. When a cut needs extra work to land exactly, the kept section is rebuilt at high quality, which looks the same to almost everyone. If you trim the same file many times over, keep the original around.',
    },
    {
      q: 'Can I cut the middle out of a video?',
      a: 'Yes. Choose "Cut parts out", mark each section to remove, and the tool joins the remaining parts into one video. Use "Keep one part" when you only want a single continuous section.',
    },
  ]}
>
  <ToolkitTabs
    current="/video-trimmer"
    tabs={[
      { href: '/video-compressor', label: 'Compress' },
      { href: '/video-trimmer', label: 'Trim' },
      { href: '/video-converter', label: 'Convert' },
      { href: '/subtitle-editor', label: 'Subtitles' },
    ]}
  />
  <section class="tool-card" slot="tool" aria-label="Video trimmer tool">
    <div id="dropzone" class="dropzone" tabindex="0" role="button" aria-label="Add a video to trim">
      <div class="dz-icon"><Icon name="video" size={30} /></div>
      <div class="dz-title">Drop video here</div>
      <div class="dz-sub">or click to choose a file &middot; it stays on your device</div>
    </div>
    <input type="file" id="file-input" accept="video/*,.mkv,.mov,.webm,.mp4,.m4v,.avi" hidden />
    <div id="error-box" class="error-box" hidden></div>
    <p id="file-info" class="count-label"></p>
    <p id="size-note" class="hint" hidden></p>
    <div id="preview-wrap" hidden>
      <video id="preview" class="preview-video" controls muted playsinline></video>
    </div>
    <div id="timeline-wrap" hidden>
      <div id="timeline" class="timeline" role="slider" aria-label="Trim range timeline" tabindex="0">
        <canvas id="filmstrip" style="position:absolute;inset:0;width:100%;height:100%;border-radius:7px;"></canvas>
        <div id="timeline-range" class="timeline-range"></div>
        <div id="timeline-start" class="timeline-handle"></div>
        <div id="timeline-end" class="timeline-handle"></div>
        <div id="timeline-playhead" class="timeline-playhead" hidden></div>
      </div>
      <p id="timeline-caption" class="hint"></p>
    </div>

    <h3 class="tool-step">What to do</h3>
    <div class="radio-cards" role="radiogroup" aria-label="Trim mode">
      <label class="radio-card"><input type="radio" name="trim-mode" value="keep" checked /><span><strong>Keep one part</strong><small>Choose the section to keep.</small></span></label>
      <label class="radio-card"><input type="radio" name="trim-mode" value="cut" /><span><strong>Cut parts out</strong><small>Remove sections; the rest is joined.</small></span></label>
    </div>
    <p id="engine-status" class="engine-status" hidden></p>

    <div id="keep-ui">
    <div class="time-row">
      <div class="time-field">
        <label for="start-input">Keep from</label>
        <input type="text" id="start-input" value="0:00.0" inputmode="decimal" />
      </div>
      <div class="time-field">
        <label for="end-input">Keep until</label>
        <input type="text" id="end-input" value="0:00.0" inputmode="decimal" />
      </div>
    </div>
    <p id="range-hint" class="count-label"></p>
    </div>

    <div id="cut-ui" hidden>
      <p class="hint">Mark the parts to remove, in seconds like <code>90</code> or <code>1:30.5</code>. Everything else is joined back into one video.</p>
      <div id="cut-list" class="cue-list"></div>
      <div class="btn-row">
        <button id="add-cut-btn" type="button" class="btn btn-secondary">Add a section to cut</button>
      </div>
      <p id="cut-hint" class="count-label"></p>
    </div>

    <div class="btn-row">
      <button id="trim-btn" class="btn" disabled>Trim video</button>
    </div>
    <div id="progress-wrap" class="progress-wrap" hidden>
      <div class="progress-label" id="progress-label"></div>
      <div class="progress-track"><div class="progress-bar" id="progress-bar"></div></div>
    </div>
    <div id="result" class="result" hidden>
      <h3>Trimmed</h3>
      <p id="result-info"></p>
    </div>
  </section>
  <script>
    import { initVideoTrimmer } from '../tools/video-trimmer';
    initVideoTrimmer();
  </script>
</ToolPage>
