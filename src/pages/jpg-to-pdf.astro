---
import ToolPage from '../layouts/ToolPage.astro';

const title = 'JPG to PDF Free — Convert JPG to PDF Online, No Upload, No Watermark';
const description =
  'Convert JPG photos to a single PDF for free. No upload, no watermark, no signup. Your files never leave your browser.';
const h1 = 'JPG to PDF';
const lede = 'This tool is now part of Images to PDF, which handles JPG, PNG, and WebP.';
---
<ToolPage
  title={title}
  description={description}
  h1={h1}
  lede={lede}
  crumbs={[{ label: 'PDF tools', href: '/pdf-tools' }, { label: 'JPG to PDF', href: '/jpg-to-pdf' }]}
  toolName="TruePDF JPG to PDF"
  intro={[
    'JPG to PDF is now part of Images to PDF, which converts JPG, PNG, and WebP images to PDF.',
  ]}
  steps={[]}
  specs={[]}
  faqs={[]}
>
  <div style="text-align: center; padding: 40px 20px;">
    <p style="font-size: 18px; margin-bottom: 20px;">This tool has moved.</p>
    <a href="/images-to-pdf" style="display: inline-block; padding: 12px 24px; background: var(--accent); color: white; text-decoration: none; border-radius: 6px; font-weight: 600;">Open Images to PDF</a>
  </div>
  <script>
    setTimeout(() => { window.location.replace('/images-to-pdf'); }, 2500);
  </script>
</ToolPage>
