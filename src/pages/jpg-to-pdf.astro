---
import ToolPage from '../layouts/ToolPage.astro';
import Icon from '../components/Icon.astro';

const title = 'JPG to PDF Free — Convert JPG to PDF Online, No Upload, No Watermark';
const description =
  'Convert JPG photos to a single PDF for free. No upload, no watermark, no signup. Your files never leave your browser.';
const h1 = 'JPG to PDF';
const lede = 'Turn JPG photos into one PDF document. Arrange the page order, pick a page size, download. Free, no account, no watermark.';
---
<ToolPage
  title={title}
  description={description}
  h1={h1}
  lede={lede}
  crumbs={[{ label: 'PDF tools', href: '/pdf-tools' }, { label: 'JPG to PDF', href: '/jpg-to-pdf' }]}
  toolName="TruePDF JPG to PDF"
  intro={[
    'Converting a JPG to PDF is one of the most common file chores on the internet: a photo of a signed form, a scan of a receipt, a phone picture of a document, a set of screenshots that a website wants as a single upload. Search engines know this, and the top results are converters that cap how many photos you can convert, shrink your images, stamp a watermark, or ask you to create an account before you can download.',
    'This converter takes your JPG photos and lays each one onto its own PDF page, in the order you arrange. Choose "fit to image" to keep every photo at its exact size, or fit every photo onto standard A4 or US Letter pages with clean margins for printing. Photos are embedded exactly as they are — no recompression, no shrinking, no quality loss.',
    'Like every TruePDF tool, the conversion runs entirely on your device. That matters more than usual here, because JPGs people convert are often personal: IDs, receipts, signed contracts, medical letters. They are never uploaded, never stored, and never seen by anyone but you.',
  ]}
  steps={[
    'Drop your JPG photos onto the box above, or click it to browse. They appear as thumbnails in order.',
    'Reorder the photos with the up and down arrows. The first photo becomes page one.',
    'Choose a page size: fit each page to its photo, or use A4 or US Letter with margins.',
    'Click "Create PDF" and download the result.',
  ]}
  specs={[
    ['Cost', 'Free, no limits'],
    ['Signup', 'None. No account, no email.'],
    ['Watermark', 'None'],
    ['Where files are processed', 'In your browser, on your device'],
    ['Input formats', 'JPEG (.jpg, .jpeg). PNG, WebP, GIF, BMP also work.'],
    ['Page sizes', 'Fit to image, A4, US Letter'],
    ['Photo limit', 'None enforced. Very large sets are limited only by your device\u2019s memory.'],
    ['Quality', 'JPEG photos are embedded as-is; no recompression, no resizing'],
    ['Works offline', 'Yes, once the page has loaded'],
  ]}
  faqs={[
    {
      q: 'Is converting JPG to PDF really free?',
      a: 'Yes. No limits on the number of photos, no watermarks, no account. The conversion is a local operation, so there is no per-file cost to pass on to you.',
    },
    {
      q: 'Are my JPGs uploaded anywhere?',
      a: 'No. Everything happens in your browser on your own device. This is deliberate: people convert IDs, receipts, and personal photos, and none of that should travel to a server.',
    },
    {
      q: 'Will my photos lose quality in the PDF?',
      a: 'No. JPEG photos are kept in the PDF exactly as they are, with no quality loss and no shrinking (unless you choose A4 or Letter and the photo is larger than the page).',
    },
    {
      q: 'Can I convert multiple JPGs into one PDF?',
      a: 'Yes. Add as many photos as you like; each one becomes its own page, in the order you arrange. Reorder them with the up and down arrows before converting.',
    },
    {
      q: 'What page size should I choose?',
      a: '"Fit to image" makes each PDF page exactly the size of its photo, with no scaling and no margins — best for photos and scans you want at full size. A4 and US Letter scale each photo to fit a standard page with half-inch margins, which is best for documents you plan to print.',
    },
    {
      q: 'What is the difference between this and the Images to PDF tool?',
      a: 'This page is the same conversion engine tuned for JPG photos, with the file picker preset to JPEG. If you also have PNG, WebP, GIF, or BMP files, the Images to PDF page takes any image format.',
    },
    {
      q: 'Can I convert HEIC photos from my iPhone?',
      a: 'Not directly yet. iPhone photos in HEIC format need to be converted to JPEG or PNG first (your phone can do this when sharing or exporting). Standard JPEG exports work fine here.',
    },
    {
      q: 'How many JPGs can I convert at once?',
      a: 'There is no built-in cap. The practical limit is your device\u2019s memory: a few dozen phone photos convert in seconds, while hundreds of huge images may take longer. If the browser struggles, convert in smaller batches and merge the PDFs afterwards.',
    },
  ]}
  usecases={[
    {
      h: 'Scans and photographed documents',
      p: 'Phone photos of contracts, forms, IDs, receipts, and handwritten notes become a proper PDF in seconds. Use A4 or US Letter pages when the document will be printed or filed, so it looks right on standard paper.',
    },
    {
      h: 'Photo sets that need to be one file',
      p: 'Rental applications, insurance claims, expense reports, and job submissions often require a single file instead of a dozen attachments. Drop the photos in, order them, and download one PDF.',
    },
    {
      h: 'Preserving photos at full quality',
      p: 'JPEGs are embedded untouched, so scanned artwork, evidence photos, and archival scans keep every pixel. Fit-to-image pages keep each photo at its exact dimensions rather than forcing it onto a page.',
    },
  ]}
>
  <section class="tool-card" slot="tool" aria-label="JPG to PDF tool">
    <div id="dropzone" class="dropzone" tabindex="0" role="button" aria-label="Add JPG photos to convert">
      <div class="dz-icon"><Icon name="upload" size={30} /></div>
      <div class="dz-title">Drop JPGs here</div>
      <div class="dz-sub">or click to choose files &middot; JPG, JPEG &middot; they stay on your device</div>
    </div>
    <input type="file" id="file-input" multiple hidden />
    <div id="error-box" class="error-box" hidden></div>
    <ul id="file-list" class="file-list"></ul>
    <p id="empty-state" class="empty-state">No photos yet. Add your JPGs above, then arrange them in page order.</p>
    <div class="field">
      <label for="page-size">Page size</label>
      <select id="page-size">
        <option value="fit">Fit to image (each page matches its photo)</option>
        <option value="a4">A4 (photos scaled to fit, with margins)</option>
        <option value="letter">US Letter (photos scaled to fit, with margins)</option>
      </select>
    </div>
    <div class="btn-row">
      <button id="convert-btn" class="btn" disabled>Create PDF</button>
      <span id="count-label" class="count-label"></span>
    </div>
    <div id="result" class="result" hidden>
      <h3>Done</h3>
      <p id="result-info"></p>
      <div id="preview-wrap" class="pdf-preview-wrap" hidden></div>
      <button id="download-btn" class="btn">Download PDF</button>
    </div>
  </section>
  <script>
    import { initImagesToPdf } from '../tools/images-to-pdf';
    initImagesToPdf({ accept: 'image/jpeg', fallbackName: 'jpg.pdf' });
  </script>
</ToolPage>
