---
import ToolPage from '../layouts/ToolPage.astro';

const title = 'Merge PDF Free — Combine PDFs, No Upload, No Watermark';
const description =
  'Combine multiple PDF files into one document for free. No signup, no watermark, no daily limits. Your files never leave your browser.';
const h1 = 'Merge PDF';
const lede = 'This tool is now part of the PDF Editor, which merges PDFs and handles every other PDF job in one workspace.';
---
<ToolPage
  title={title}
  description={description}
  h1={h1}
  lede={lede}
  crumbs={[{ label: 'PDF tools', href: '/pdf-tools' }, { label: 'Merge PDF', href: '/merge-pdf' }]}
  toolName="TruePDF Merge PDF"
  intro={[
    'Merging PDFs now happens inside the PDF Editor. Drop your files there and their pages join one workspace, where you can also reorder, rotate, delete, edit text, add watermarks and page numbers, or protect the file with a password.',
  ]}
  steps={[]}
  specs={[]}
  faqs={[]}
>
  <div style="text-align: center; padding: 40px 20px;">
    <p style="font-size: 18px; margin-bottom: 20px;">This tool has moved into the PDF Editor.</p>
    <a href="/pdf-editor" style="display: inline-block; padding: 12px 24px; background: var(--accent); color: white; text-decoration: none; border-radius: 6px; font-weight: 600;">Open the PDF Editor</a>
  </div>
  <script>
    setTimeout(() => { window.location.replace('/pdf-editor'); }, 2500);
  </script>
</ToolPage>
