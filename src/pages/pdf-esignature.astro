---
import ToolPage from '../layouts/ToolPage.astro';
import Icon from '../components/Icon.astro';

const title = 'Sign PDF - Free Online PDF Signature Tool';
const description =
  'Sign a PDF online for free, in your browser. Draw your signature or type your name, place it on any page, download the signed copy. No signup, no watermark.';
const h1 = 'Sign a PDF';
const lede = 'Draw or type your signature, click where it goes, download the signed PDF. Free, no account, no watermark.';
---
<ToolPage
  title={title}
  description={description}
  h1={h1}
  lede={lede}
  crumbs={[{ label: 'PDF tools', href: '/pdf-tools' }, { label: 'Sign PDF', href: '/pdf-esignature' }]}
  toolName="GratisBench Sign PDF"
  intro={[
    'Signing a PDF usually means one of two annoyances: printing it, signing with a pen, and scanning it back in, or creating an account with a signature service that wants your email before it will let you draw three letters. For everyday documents, a consent form, a freelance contract, a school permission slip, that is a lot of ceremony for a squiggle.',
    'This tool keeps it simple. Draw your signature with a mouse, trackpad, or finger on the pad, or type your name and get a script-style rendering of it. Then click on any page of your PDF to place it exactly where you want. The signature is flattened into the document as part of the page, so the downloaded file looks signed everywhere it is opened, with no special software needed to view it.',
    'One honest note: this is a simple drawn or typed mark on the document, the digital equivalent of signing with a pen. It is not a cryptographic digital signature with a certificate, which is a different thing used for high-assurance legal workflows. For everyday agreements it is exactly what people mean by "sign this PDF". Everything runs in your browser, so the document you are signing never leaves your device.',
  ]}
  steps={[
    'Draw your signature on the pad with a mouse, trackpad, or finger, then click "Use this signature". Prefer typing? Switch to the Type tab, enter your name, and click "Create signature".',
    'Drop your PDF onto the box, or click it to browse. A preview of every page appears.',
    'Click on a page where the signature should go. It lands centered on your click.',
    'Adjust the size slider if the signature needs to be bigger or smaller, then click again to reposition.',
    'Click "Sign and download" to get the signed copy. Place it on several pages first if the document needs more than one signature.',
  ]}
  specs={[
    ['Cost', 'Free, no limits'],
    ['Signup', 'None. No account, no email.'],
    ['Watermark', 'None. The output is your document with your signature, nothing added.'],
    ['Where files are processed', 'In your browser, on your device'],
    ['Signature styles', 'Draw freehand, or type your name for a script-style rendering'],
    ['Placement', 'Click to place on any page; size slider; one signature per page (click again to move it)'],
    ['How it is stored', 'Flattened into the page as an image; visible in any PDF reader'],
    ['Signature type', 'A drawn or typed mark, not a certificate-based digital signature'],
    ['Output filename', 'Your original name with "-signed" added'],
    ['Password-protected PDFs', 'Not supported. Remove the password first, then sign.'],
  ]}
  faqs={[
    {
      q: 'Is this a legally valid signature?',
      a: 'For most everyday purposes, yes: a drawn or typed mark that you placed yourself is what people and businesses accept as an electronic signature on routine documents. Rules vary by country and by document type, and some regulated workflows require certificate-based digital signatures instead. If a contract specifies a particular signing method, follow that; for everything else, this is the normal approach.',
    },
    {
      q: 'What is the difference between this and a digital signature?',
      a: 'This tool places a visible mark, like signing with a pen. A certificate-based digital signature is invisible cryptography that proves who signed and detects later changes. They solve different problems. If someone asks you to "digitally sign" with a certificate from an authority, you need dedicated software; if they just need your signature on the page, this tool does it.',
    },
    {
      q: 'Can I sign multiple pages?',
      a: 'Yes. Click on each page that needs a signature; the placements are listed so you can review them before downloading. Clicking a page that already has a signature moves it to the new spot. Each placement can be removed individually from the list.',
    },
    {
      q: 'My handwriting with a mouse is terrible. Any tips?',
      a: 'Draw slowly and a bit larger than you think; the pad trims the empty space around your strokes, so a big loose signature shrinks down neatly. On a phone or tablet, use your finger or a stylus for much better control. Or skip drawing entirely and use the Type tab, which renders your name in a script style.',
    },
    {
      q: 'Can I save my signature for next time?',
      a: 'No, deliberately. Storing your signature in the browser would mean keeping a copy of it around on your device, and this tool is designed to leave no trace when you close the tab. Drawing it fresh each time takes a few seconds and keeps things clean.',
    },
    {
      q: 'Will the signature show up when someone else opens the PDF?',
      a: 'Yes. The signature is flattened into the page as an image when the file is built, so it displays in every PDF reader, on every device, with nothing to install. It cannot be moved or edited afterwards, which is what you want from a signed copy.',
    },
    {
      q: 'Are my documents uploaded anywhere?',
      a: 'No. The signature and the PDF are combined entirely in your browser. Nothing is sent to a server, which matters when the document you are signing is private.',
    },
  ]}
>
  <section class="tool-card" slot="tool" aria-label="Sign PDF tool">
    <h3 class="tool-step">1. Create your signature</h3>
    <div class="tab-bar" role="tablist" aria-label="Signature style">
      <button type="button" id="sig-tab-draw" class="tab-btn tab-active" role="tab" aria-selected="true">Draw</button>
      <button type="button" id="sig-tab-type" class="tab-btn" role="tab" aria-selected="false">Type</button>
    </div>
    <div id="sig-panel-draw">
      <canvas id="sig-pad" class="sig-pad" width="520" height="180" aria-label="Draw your signature here"></canvas>
      <div class="btn-row">
        <button id="sig-clear" class="btn btn-secondary" type="button">Clear</button>
        <button id="sig-use-drawn" class="btn" type="button">Use this signature</button>
      </div>
    </div>
    <div id="sig-panel-type" hidden>
      <div class="field">
        <label for="sig-name">Your name</label>
        <input type="text" id="sig-name" placeholder="Jane Appleseed" autocomplete="off" maxlength="40" />
        <p class="hint">Rendered in a script style. This is a typed mark, not handwriting.</p>
      </div>
      <div class="btn-row">
        <button id="sig-create" class="btn" type="button">Create signature</button>
      </div>
    </div>
    <div class="sig-preview-box">
      <img id="sig-preview" alt="Your signature" hidden />
      <p id="sig-status" class="engine-status">No signature yet.</p>
    </div>

    <h3 class="tool-step">2. Add your PDF and place the signature</h3>
    <div id="dropzone" class="dropzone" tabindex="0" role="button" aria-label="Add a PDF file to sign">
      <div class="dz-icon"><Icon name="upload" size={30} /></div>
      <div class="dz-title">Drop a PDF here</div>
      <div class="dz-sub">or click to choose a file &middot; it stays on your device</div>
    </div>
    <input type="file" id="file-input" accept="application/pdf,.pdf" hidden />
    <div id="error-box" class="error-box" hidden></div>
    <p id="doc-info" class="count-label"></p>

    <div class="field">
      <label for="sig-scale">Signature size</label>
      <div class="range-row">
        <input type="range" id="sig-scale" min="40" max="200" value="100" />
        <span class="range-val" id="sig-scale-value">100%</span>
      </div>
    </div>

    <p id="pages-empty" class="empty-state">No pages yet. Add a PDF above, then click a page to place your signature.</p>
    <div id="pages-wrap"></div>

    <h3 class="tool-step">3. Review and download</h3>
    <p class="count-label" id="placements-label">No placements yet.</p>
    <ul id="placements-list" class="file-list"></ul>
    <div class="btn-row">
      <button id="sign-btn" class="btn" disabled>Sign and download</button>
    </div>
    <div id="result" class="result" hidden>
      <h3>Signed</h3>
      <p id="result-info"></p>
      <button id="download-btn" class="btn">Download PDF</button>
    </div>
  </section>
  <script>
    import { initPdfEsignature } from '../tools/pdf-esignature';
    initPdfEsignature();
  </script>
</ToolPage>
