---
import BaseLayout from '../layouts/BaseLayout.astro';
import { basePath } from '../lib/site';

const title = 'Page not found | FreeKit';
const description = 'This page does not exist. FreeKit is a set of free tools that run in your browser.';
---
<BaseLayout title={title} description={description}>
  <div class="wrap">
    <div class="page-head">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={basePath('/')}>FreeKit</a>
      </nav>
      <h1>Page not found</h1>
      <p class="tool-desc">There is nothing at this address. The link may be wrong, or the page may have moved.</p>
    </div>
    <div class="tool-card">
      <p>Go back to the <a href={basePath('/')}>full tool index</a> and pick what you need.</p>
    </div>
  </div>
</BaseLayout>
