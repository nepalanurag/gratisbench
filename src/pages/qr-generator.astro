---
import ToolPage from '../layouts/ToolPage.astro';

const title = 'QR Code Generator - Free Online QR Maker';
const description =
  'Create QR codes for links, text, and more. Free, no signup, no watermark. Add your logo, pick colors and size, download PNG or SVG. Everything runs in your browser.';
const h1 = 'QR code generator';
const lede = 'Make a QR code for a link or any text. Add your logo, tune the colors, download as PNG or SVG. Free, no account.';
---
<ToolPage
  title={title}
  description={description}
  h1={h1}
  lede={lede}
  crumbs={[{ label: 'QR generator', href: '/qr-generator' }]}
  toolName="FreeKit QR Code Generator"
  intro={[
    'QR codes are one of those things that should be simple and usually are not. You want a code for your menu, your Wi-Fi password, or a link on a flyer, and the first result on Google wants an account before it will let you download, or stamps its own logo on your code unless you pay. A QR code is just an encoding of some text. There is no reason it needs an account.',
    'This generator makes standard static QR codes directly in your browser. Type a link or any text, and the code updates as you type. You can add a center logo (error correction is raised automatically so the code still scans), change the colors, and download the result as a PNG for screens or as an SVG for print, where it scales to any size without going blurry.',
    'Static means the code encodes your text directly and works forever. There is no redirect service in the middle, so nothing can expire, break, or start charging you next year. If you need to change where the code points later, generate a new one; that is the honest trade-off of a code with no middleman.',
  ]}
  steps={[
    'Type or paste your link or text into the box. The preview updates automatically.',
    'Optionally upload a center logo, pick the size, error correction level, and colors.',
    'Check the preview, then download as PNG (for screens and documents) or SVG (for print).',
  ]}
  specs={[
    ['Cost', 'Free, no limits'],
    ['Signup', 'None. No account, no email.'],
    ['Watermark', 'None'],
    ['Where codes are generated', 'In your browser, on your device'],
    ['Code type', 'Static QR (encodes your text directly, works forever)'],
    ['Max input', 'About 4,000 characters; shorter inputs make easier-to-scan codes'],
    ['Sizes', '512, 1024, or 2048 px PNG; SVG scales to any size'],
    ['Center logo', 'Supported on PNG; error correction is raised to High automatically'],
    ['Works offline', 'Yes, once the page has loaded'],
  ]}
  faqs={[
    {
      q: 'Is this QR generator really free?',
      a: 'Yes. Unlimited codes, logo support, and SVG downloads are all free with no account. A QR code is generated locally in milliseconds, so there is no ongoing cost that would need a subscription to cover.',
    },
    {
      q: 'Do I need an account to download my QR code?',
      a: 'No. Plenty of generators hold the download button hostage until you sign up, or watermark the code with their own branding. Here the download buttons just work.',
    },
    {
      q: 'Will my QR code expire?',
      a: 'No. These are static codes: your text is encoded directly into the pattern, with no redirect service in between. It works as long as the link or text it contains is valid. The trade-off is that you cannot change the destination later; you would generate a new code instead.',
    },
    {
      q: 'What is error correction, and which level should I pick?',
      a: 'Error correction adds redundancy so the code still scans when part of it is dirty, damaged, or covered by a logo. Higher levels survive more damage but make the pattern denser. For a plain code, Medium is a good default. If you add a center logo, this tool raises it to High automatically, which is the right call whenever part of the code is obscured.',
    },
    {
      q: 'Can I put my logo in the middle of the QR code?',
      a: 'Yes, for PNG downloads. Upload any image and it is centered with a white backing so it stays readable. Keep the logo modest in size and always test-scan the result with your phone before printing. SVG downloads do not include the logo, since vector compositing would complicate the file.',
    },
    {
      q: 'Should I download PNG or SVG?',
      a: 'PNG is right for screens, documents, and social posts: pick 1024 or 2048 px for crisp results. SVG is right for print: flyers, packaging, signage. A vector file scales to any size without blur, which matters when a code is printed large or very small.',
    },
    {
      q: 'What can I put in a QR code besides links?',
      a: 'Any text works: plain messages, email addresses, phone numbers. Special formats are just text too. For example, most phones join a Wi-Fi network from a code containing WIFI:T:WPA;S:NetworkName;P:password;;, and a code starting with mailto: opens the email app. Paste the formatted text and the code does the rest.',
    },
    {
      q: 'Is the data I type sent anywhere?',
      a: 'No. The code is generated by JavaScript running in your browser. Nothing you type leaves your device, which is worth knowing if you are encoding anything private like a Wi-Fi password.',
    },
  ]}
>
  <section class="tool-card" slot="tool" aria-label="QR code generator">
    <div class="qr-layout">
      <div>
        <div class="field">
          <label for="qr-text">Link or text</label>
          <textarea id="qr-text" placeholder="https://example.com — or any text"></textarea>
        </div>
        <div class="row-2">
          <div class="field">
            <label for="qr-size">PNG size</label>
            <select id="qr-size">
              <option value="512">512 px</option>
              <option value="1024" selected>1024 px</option>
              <option value="2048">2048 px</option>
            </select>
          </div>
          <div class="field">
            <label for="qr-ec">Error correction</label>
            <select id="qr-ec">
              <option value="L">Low</option>
              <option value="M" selected>Medium</option>
              <option value="Q">Quartile</option>
              <option value="H">High</option>
            </select>
            <p class="hint" id="ec-note" hidden>A logo covers part of the code, so High is used automatically.</p>
          </div>
        </div>
        <div class="row-2">
          <div class="field">
            <label for="qr-dark">Code color</label>
            <input type="color" id="qr-dark" value="#000000" />
          </div>
          <div class="field">
            <label for="qr-light">Background</label>
            <div class="checkline" style="gap: 0.7rem;">
              <input type="color" id="qr-light" value="#ffffff" />
              <label class="checkline" for="qr-transparent" style="font-weight: 400;">
                <input type="checkbox" id="qr-transparent" checked /> Transparent
              </label>
            </div>
            <p class="hint">Dark codes on light backgrounds scan best.</p>
          </div>
        </div>
        <div class="field">
          <label>Center logo (optional, PNG only)</label>
          <div class="logo-pick">
            <label class="btn btn-secondary" for="logo-input" style="padding: 0.5rem 1rem; font-size: 0.94rem;">Choose logo</label>
            <input type="file" id="logo-input" accept="image/*" hidden />
            <span id="logo-name" class="file-name-label">No logo selected</span>
            <button type="button" id="remove-logo" class="link-btn" hidden>Remove</button>
          </div>
        </div>
        <div id="error-box" class="error-box" hidden></div>
      </div>
      <div>
        <div id="qr-preview-wrap" class="qr-preview-box" hidden>
          <img id="qr-preview" alt="Generated QR code preview" />
        </div>
        <div id="qr-placeholder" class="qr-placeholder">Your QR code appears here.</div>
        <div class="btn-row">
          <button id="dl-png" class="btn" disabled>Download PNG</button>
          <button id="dl-svg" class="btn btn-secondary" disabled>Download SVG</button>
        </div>
      </div>
    </div>
  </section>
  <script>
    import { initQrGenerator } from '../tools/qr-generator';
    initQrGenerator();
  </script>
</ToolPage>
