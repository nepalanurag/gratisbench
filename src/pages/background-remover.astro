---
import ToolPage from '../layouts/ToolPage.astro';
import Icon from '../components/Icon.astro';

const title = 'Background Remover - Free AI Background Removal, Full Resolution';
const description =
  'Remove the background from any photo for free, in your browser. Full-resolution transparent PNG download, no signup, no watermark. Your images never leave your device.';
const h1 = 'Remove image backgrounds';
const lede = 'AI background removal that runs on your device. Full-resolution transparent PNG, free, no account, no watermark.';
---
<ToolPage
  title={title}
  description={description}
  h1={h1}
  lede={lede}
  crumbs={[{ label: 'Image tools', href: '/image-tools' }, { label: 'Background remover', href: '/background-remover' }]}
  toolName="FreeKit Background Remover"
  intro={[
    'Removing a background used to mean either paying for Photoshop or feeding your photos to a service like remove.bg, which gives you a tiny 0.25-megapixel preview for free and charges for the full-resolution version. One credit per image, subscriptions that renew whether you use them or not. It is a simple job wrapped in a pricing page.',
    'This tool runs a real AI segmentation model right here in your browser. Drop in a photo, and the model figures out which pixels are the subject and which are the background, then hands you a full-resolution transparent PNG. No account, no credits, no "free preview" upsell. The output is the actual full-size image, because there is no server bill to recover.',
    'Everything happens on your device. The model downloads once (about 40 MB, cached by your browser), your photo is processed locally, and when you close the tab nothing remains anywhere but your own computer. Portraits, product shots, and pet photos all work; wispy hair and glass are hard for every background remover, including the paid ones, so check the edges before you ship something important.',
  ]}
  steps={[
    'Drop an image onto the box above, or click it to browse. PNG, JPG, and WebP all work.',
    'Pick your background: transparent (a real PNG with alpha), white, or black.',
    'Click "Remove background". The first run downloads the AI model (about 40 MB, once per browser); afterwards it starts instantly.',
    'Compare the before and after with the toggle, then download the full-resolution PNG.',
  ]}
  specs={[
    ['Cost', 'Free, no limits'],
    ['Signup', 'None. No account, no email.'],
    ['Watermark', 'None.'],
    ['Where files are processed', 'In your browser, on your device'],
    ['Output', 'Full-resolution PNG, transparent or on white/black'],
    ['AI model', 'Downloads once (~40 MB), then cached in your browser'],
    ['Works offline', 'Yes, once the model has downloaded'],
    ['Best subjects', 'People, pets, products with a clear subject'],
    ['Honest limits', 'Fine hair, fur edges, glass, and busy backgrounds may need touch-ups'],
  ]}
  faqs={[
    {
      q: 'Is this background remover really free at full resolution?',
      a: 'Yes. Services like remove.bg charge per image for anything beyond a small preview, but this tool has no server costs to recover: the AI model runs on your own device, so the full-resolution PNG is free. There is no credit system, no daily quota, and no paid tier above it.',
    },
    {
      q: 'Are my photos uploaded anywhere?',
      a: 'No. The model file downloads from a CDN once, but your photo is processed entirely in your browser and never sent to any server. This makes the tool safe for client work, product photos, and anything else you would rather not upload.',
    },
    {
      q: 'Why does the first run take a while?',
      a: 'The first run downloads the AI model, about 40 MB. That download happens once per browser and is then cached, so later visits start the removal almost immediately and even work offline. If it ever seems stuck, check your connection and try again.',
    },
    {
      q: 'What kinds of images work best?',
      a: 'Clear subjects against a reasonably distinct background: portraits, pets, product shots, logos photographed on a desk. The model struggles where every background remover struggles: wispy hair, fur, transparent objects like glass, and backgrounds that blend into the subject. Zoom in on the edges before using the result professionally.',
    },
    {
      q: 'Can I get a white or black background instead of transparency?',
      a: 'Yes. Choose white or black before or after removing the background; the cut-out is composited onto the solid color at full resolution and downloaded as a PNG. Transparency is the default and is what you want for overlays, thumbnails, and design work.',
    },
    {
      q: 'Which browsers are supported?',
      a: 'Any recent Chrome, Edge, Firefox, or Safari. The AI engine needs WebAssembly, which every modern browser has. Very old browsers or ones with WebAssembly disabled will show an error instead of a result.',
    },
    {
      q: 'How is this different from remove.bg?',
      a: 'remove.bg is a paid API with a free low-resolution preview; full-resolution downloads cost credits. This tool runs an open segmentation model locally in your browser, so there is no per-image cost and no account. The trade-off is that the first visit downloads the model, and very tricky images may need the touch-up tools a paid editor provides.',
    },
    {
      q: 'Can I remove backgrounds from many images at once?',
      a: 'One image at a time. Batch processing would keep the model hot in memory, which is fine, but the UI is built around inspecting each result. Process them one by one; repeat runs start instantly because the model stays cached.',
    },
  ]}
>
  <section class="tool-card" slot="tool" aria-label="Background remover tool">
    <div id="dropzone" class="dropzone" tabindex="0" role="button" aria-label="Add an image to remove its background">
      <div class="dz-icon"><Icon name="upload" size={30} /></div>
      <div class="dz-title">Drop an image here</div>
      <div class="dz-sub">or click to choose a file &middot; it stays on your device</div>
    </div>
    <input type="file" id="file-input" accept="image/png,image/jpeg,image/webp" hidden />
    <div id="error-box" class="error-box" hidden></div>
    <p class="honest-note"><strong>One download, then it is yours:</strong> the AI model (about 40&nbsp;MB) downloads once per browser on first use, then stays cached. Your photo is processed on your device and never uploaded.</p>

    <div class="field">
      <label id="bg-label">Background</label>
      <div class="radio-cards" role="radiogroup" aria-labelledby="bg-label">
        <label class="radio-card"><input type="radio" name="bg-choice" value="transparent" checked /><span><strong>Transparent</strong><small>True PNG with alpha, for overlays and design</small></span></label>
        <label class="radio-card"><input type="radio" name="bg-choice" value="white" /><span><strong>White</strong><small>Clean cut-out on a white background</small></span></label>
        <label class="radio-card"><input type="radio" name="bg-choice" value="black" /><span><strong>Black</strong><small>Cut-out on black, for dark designs</small></span></label>
      </div>
    </div>

    <div id="preview-block" hidden>
      <p id="file-meta" class="count-label"></p>
      <div class="preview-frame">
        <img id="original-preview" alt="Original image" />
        <img id="result-preview" alt="Image with background removed" hidden />
      </div>
      <div class="view-toggle" role="group" aria-label="Compare before and after">
        <button id="view-original-btn" class="btn btn-secondary active" type="button">Before</button>
        <button id="view-result-btn" class="btn btn-secondary" type="button" disabled>After</button>
      </div>
    </div>

    <div id="progress-wrap" class="progress-wrap" hidden>
      <div class="progress-label" id="progress-label"></div>
      <div class="progress-track"><div class="progress-bar" id="progress-bar"></div></div>
    </div>

    <div class="btn-row">
      <button id="remove-btn" class="btn" disabled>Remove background</button>
    </div>

    <div id="result-block" class="result" hidden>
      <h3>Done</h3>
      <p id="result-info"></p>
      <button id="download-btn" class="btn">Download PNG</button>
    </div>
  </section>
  <script>
    import { initBackgroundRemover } from '../tools/background-remover';
    initBackgroundRemover();
  </script>
</ToolPage>
