---
import ToolPage from '../layouts/ToolPage.astro';

const title = 'Business Profile - Save Your Logo & Details Once | GratisBench';
const description =
  'Save your business name, logo, address, and contact details once in your browser. The invoice generator and email signature generator fill them in automatically. Free, private, nothing uploaded.';
const h1 = 'Business profile';
const lede =
  'Type your business details once. The invoice generator and the email signature generator pull them in on their own, so you stop re-typing your address and re-uploading your logo.';
---
<ToolPage
  title={title}
  description={description}
  h1={h1}
  lede={lede}
  crumbs={[{ label: 'Business tools', href: '/business-tools' }, { label: 'Business profile', href: '/business-profile' }]}
  toolName="GratisBench Business Profile"
  intro={[
    'Most business tools ask for the same details every time: your name, address, phone, logo. This page stores them once, in your browser, and the other GratisBench business tools read from that same store. Fill in the invoice generator and your business block is already there. Open the email signature generator and your company, website, and logo are filled in.',
    'Everything stays on your device. There is no account and no server, so your profile cannot leak, but it also does not follow you to another computer. Use the export button to download your profile as a JSON file, then import it on your other device.',
  ]}
  steps={[
    'Fill in your business name, address, email, phone, website, and tagline. Pick your brand color.',
    'Upload your logo. It is shrunk to a reasonable size before saving so it stays light.',
    'Your changes save automatically. Open the invoice generator or the email signature generator and the details are already filled in.',
    'Moving devices? Click Export to download your profile, then Import on the new device.',
  ]}
  specs={[
    ['Cost', 'Free, no limits'],
    ['Signup', 'None. No account, no email.'],
    ['Where it is stored', 'In this browser only (local storage). Nothing is uploaded.'],
    ['Logo', 'JPG or PNG, shrunk to 360 px max before saving. PNG keeps transparency.'],
    ['Export format', 'A plain JSON file you can back up or move to another device.'],
    ['Tools that use it', 'Invoice generator and email signature generator'],
    ['Works offline', 'Yes, once the page has loaded'],
  ]}
  faqs={[
    {
      q: 'Is my business information private?',
      a: 'Yes. It lives in your browser\u2019s local storage on your own device, the same as the other GratisBench tools. Nothing is sent anywhere, because there is no server to send it to.',
    },
    {
      q: 'What happens if I clear my browser data?',
      a: 'Your profile is deleted along with everything else in local storage. Export it first with the Export button and keep the JSON file somewhere safe.',
    },
    {
      q: 'Can I use this on a second computer?',
      a: 'Yes. Click Export here to download your profile as a file, then open this page on the other computer and click Import to load it.',
    },
    {
      q: 'Can I still type different details in one invoice?',
      a: 'Yes. The profile only fills in empty fields. Anything you type directly in the invoice generator or signature generator stays as you typed it and is never overwritten.',
    },
    {
      q: 'I already filled in my details in the invoice generator. Do I have to type them again?',
      a: 'No. If your profile is empty but the invoice generator already has your business details saved, they are copied into your profile automatically the next time you open the invoice generator.',
    },
  ]}
>
  <section class="tool-card" slot="tool" aria-label="Business profile settings">
    <p class="mono-label">Your details, saved in this browser</p>
    <div id="bp-error" class="error-box" hidden></div>
    <p id="bp-empty-note" hidden>Nothing saved yet. Fill in the fields below and they will be waiting for you in the invoice and signature tools.</p>

    <div class="row-2">
      <div class="field">
        <label for="bp-name">Business name</label>
        <input id="bp-name" type="text" autocomplete="organization" placeholder="Rivera Design Studio" />
      </div>
      <div class="field">
        <label for="bp-tagline">Tagline</label>
        <input id="bp-tagline" type="text" placeholder="Brand and web design" />
      </div>
    </div>
    <div class="field">
      <label for="bp-address">Address</label>
      <textarea id="bp-address" rows="2" autocomplete="street-address" placeholder="418 Harbor Ave, Suite 12&#10;San Francisco, CA 94123"></textarea>
    </div>
    <div class="row-2">
      <div class="field">
        <label for="bp-email">Email</label>
        <input id="bp-email" type="email" autocomplete="email" placeholder="hello@example.com" />
      </div>
      <div class="field">
        <label for="bp-phone">Phone</label>
        <input id="bp-phone" type="tel" autocomplete="tel" placeholder="(415) 555-0132" />
      </div>
    </div>
    <div class="row-2">
      <div class="field">
        <label for="bp-website">Website</label>
        <input id="bp-website" type="text" inputmode="url" autocomplete="url" placeholder="example.com" />
      </div>
      <div class="field">
        <label for="bp-color">Brand color</label>
        <input id="bp-color" type="color" value="#a63d21" />
      </div>
    </div>

    <div class="field">
      <label for="bp-logo-input">Logo</label>
      <img id="bp-logo-preview" class="bp-logo-img" hidden alt="Your logo preview" />
      <div class="btn-row btn-row-none">
        <label class="btn btn-secondary file-label" for="bp-logo-input">Upload logo</label>
        <button id="bp-logo-clear" class="btn btn-secondary" type="button" hidden>Remove logo</button>
      </div>
      <input id="bp-logo-input" type="file" accept="image/*" hidden />
    </div>

    <p class="mono-label mono-label-gap">Backup</p>
    <div class="btn-row">
      <button id="bp-save" class="btn" type="button">Save profile</button>
      <button id="bp-export" class="btn btn-secondary" type="button">Export</button>
      <button id="bp-import" class="btn btn-secondary" type="button">Import</button>
      <button id="bp-clear" class="btn btn-secondary" type="button">Clear</button>
    </div>
    <input id="bp-import-input" type="file" accept="application/json,.json" hidden />
    <p id="bp-saved" class="mono-label" hidden>Saved.</p>
    <p><span class="stamp">Your files never leave your device</span></p>
  </section>
  <script>
    import { initBusinessProfile } from '../tools/business-profile';
    initBusinessProfile();
  </script>
</ToolPage>
