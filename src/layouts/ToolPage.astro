---
import BaseLayout from './BaseLayout.astro';
import SupportNotice from '../components/SupportNotice.astro';
import { siteUrl, basePath, stripBase } from '../lib/site';

interface Crumb { label: string; href: string }
interface Faq { q: string; a: string }

interface Props {
  title: string;
  description: string;
  h1: string;
  lede: string;
  crumbs: Crumb[];
  toolName: string;
  intro: string[];
  steps: string[];
  specs: [string, string][];
  faqs: Faq[];
  usecases?: { h: string; p: string }[];
}

const { title, description, h1, lede, crumbs, toolName, intro, steps, specs, faqs, usecases = [] } = Astro.props;
const site = siteUrl(Astro.site);
// siteUrl() already includes the base path, so strip it from the pathname
// before joining (same doubling bug as the canonical once had).
const pageUrl = site + stripBase(Astro.url.pathname);

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: toolName,
    url: pageUrl,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any (web browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'TruePDF', item: site + '/' },
      ...crumbs.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 2,
        name: c.label,
        // Trailing slash to match the canonical URLs.
        item: site + (c.href.endsWith('/') ? c.href : c.href + '/'),
      })),
    ],
  },
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---
<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="wrap">
    <div class="page-head">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={basePath('/')}>TruePDF</a>
        {crumbs.map((c) => (
          <span><span class="sep">/</span><a href={basePath(c.href)}>{c.label}</a></span>
        ))}
      </nav>
      <h1>{h1}</h1>
      <p class="tool-desc">{lede}</p>
      <p class="trust-row" aria-label="This tool is free with no watermark, no signup, and files stay on your device">
        <span><span class="tick">&#10003;</span> 100% Free</span>
        <span><span class="tick">&#10003;</span> No Watermark</span>
        <span><span class="tick">&#10003;</span> No Signup</span>
        <span><span class="tick">&#10003;</span> Files never leave your device</span>
      </p>
    </div>

    <!-- Ad slot: above the tool (AdSense display unit goes here) -->
    <div class="ad-slot" data-ad-slot="tool-top" aria-hidden="true"><span>Advertisement</span></div>

    <slot name="tool" />
    <slot />
    <!--
      The default slot above renders each tool page's <script> block.
      Without it, Astro silently drops page scripts (they are compiled
      but never injected into the HTML), leaving every tool dead.
    -->

    <script>
      // Remember the last-used tool for the homepage "pick up where you left off" card.
      try {
        const h1 = document.querySelector('.page-head h1');
        const name = h1 ? (h1.textContent || '').trim() : '';
        if (name) {
          localStorage.setItem(
            'truepdf-last-tool',
            JSON.stringify({ href: window.location.pathname, name, t: Date.now() })
          );
        }
      } catch { /* localStorage unavailable — skip quietly */ }
    </script>

    <!-- Ad slot: below the tool / results area (AdSense display unit goes here) -->
    <div class="ad-slot" data-ad-slot="tool-bottom" aria-hidden="true"><span>Advertisement</span></div>

    <SupportNotice />

    <div class="content">
      <details class="intro-more">
        <summary>About this tool</summary>
        {intro.map((p) => <p>{p}</p>)}
      </details>

      <h2>How to use it</h2>
      <ol class="steps">
        {steps.map((s) => <li>{s}</li>)}
      </ol>

      <h2>Details</h2>
      <table>
        <tbody>
          {specs.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
        </tbody>
      </table>

      {usecases.length > 0 && (
        <>
          <h2>Common uses</h2>
          {usecases.map((u) => (
            <div class="usecase">
              <h3>{u.h}</h3>
              <p>{u.p}</p>
            </div>
          ))}
        </>
      )}

      <h2>Common questions</h2>
      <dl>
        {faqs.map((f) => (
          <div class="faq">
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</BaseLayout>
