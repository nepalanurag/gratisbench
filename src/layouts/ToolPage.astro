---
import BaseLayout from './BaseLayout.astro';
import Icon from '../components/Icon.astro';
import SupportNotice from '../components/SupportNotice.astro';
import { siteUrl, basePath } from '../lib/site';

interface Crumb { label: string; href: string }
interface Faq { q: string; a: string }

interface Props {
  title: string;
  description: string;
  h1: string;
  lede: string;
  crumbs: Crumb[];
  toolName: string;
  intro: string[];
  steps: string[];
  specs: [string, string][];
  faqs: Faq[];
}

const { title, description, h1, lede, crumbs, toolName, intro, steps, specs, faqs } = Astro.props;
const site = siteUrl(Astro.site);
const pageUrl = site + Astro.url.pathname;

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: toolName,
    url: pageUrl,
    applicationCategory: 'UtilitiesApplication',
    operatingSystem: 'Any (web browser)',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'FreeKit', item: site + basePath('/') },
      ...crumbs.map((c, i) => ({
        '@type': 'ListItem',
        position: i + 2,
        name: c.label,
        item: site + basePath(c.href),
      })),
    ],
  },
];
---
<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <div class="wrap">
    <div class="page-head plate">
      <span class="plate-tag" aria-hidden="true">Tool file</span>
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href={basePath('/')}>FreeKit</a>
        {crumbs.map((c) => (
          <span><span class="sep">/</span><a href={basePath(c.href)}>{c.label}</a></span>
        ))}
      </nav>
      <h1>{h1}</h1>
      <p class="lede">{lede}</p>
      <div>
        <span class="privacy-line"><Icon name="lock" size={15} /> Your files never leave your device.</span>
      </div>
    </div>

    <!-- Ad slot: above the tool (AdSense display unit goes here) -->
    <div class="ad-slot" data-ad-slot="tool-top" aria-hidden="true"><span>Advertisement</span></div>

    <slot name="tool" />
    <slot />
    <!--
      The default slot above renders each tool page's <script> block.
      Without it, Astro silently drops page scripts (they are compiled
      but never injected into the HTML), leaving every tool dead.
    -->

    <!-- Ad slot: below the tool / results area (AdSense display unit goes here) -->
    <div class="ad-slot" data-ad-slot="tool-bottom" aria-hidden="true"><span>Advertisement</span></div>

    <SupportNotice />

    <div class="content">
      {intro.map((p) => <p>{p}</p>)}

      <h2>How to use it</h2>
      <ol class="steps">
        {steps.map((s) => <li>{s}</li>)}
      </ol>

      <h2>Details</h2>
      <table>
        <tbody>
          {specs.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
        </tbody>
      </table>

      <h2>Common questions</h2>
      <dl>
        {faqs.map((f) => (
          <div class="faq">
            <dt>{f.q}</dt>
            <dd>{f.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</BaseLayout>
