---
// Toolkit tab bar: groups related tools so users can switch without going back.
// Each tab is a normal link (SEO-friendly), styled as tabs for the toolkit feel.
import { basePath } from '../lib/site';

interface Tab {
  href: string;
  label: string;
}

interface Props {
  tabs: Tab[];
  current: string; // href of the active tab
}

const { tabs, current } = Astro.props;
---

<nav class="toolkit-tabs" aria-label="Related tools">
  {tabs.map((t) => (
    <a
      href={basePath(t.href)}
      class={t.href === current ? 'toolkit-tab active' : 'toolkit-tab'}
      aria-current={t.href === current ? 'page' : undefined}
    >
      {t.label}
    </a>
  ))}
</nav>

<style>
  .toolkit-tabs {
    display: flex;
    gap: 2px;
    margin: 0 0 24px;
    padding: 0;
    border-bottom: 1px solid var(--line);
    overflow-x: auto;
  }
  .toolkit-tab {
    flex: 1 0 auto;
    text-align: center;
    padding: 10px 16px;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
    text-decoration: none;
    white-space: nowrap;
    transition: color 0.15s, border-color 0.15s;
  }
  .toolkit-tab:hover {
    color: var(--ink);
  }
  .toolkit-tab.active {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }
</style>
